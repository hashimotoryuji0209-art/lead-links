ath[expr] = [this.className.match(_e.arrowTplExprReg)[0]];\r\n                            }else{\r\n                                info.path[expr] = [this.tagName.toLowerCase()];\t\r\n                            }\r\n                            \r\n                        }else{\r\n                            info.path[expr].push(this.tagName.toLowerCase());\r\n                        }\r\n                    });\r\n                }\r\n            });\r\n            if(!info.path['loop-item']){\r\n                info.path['loop-item'] = [];\r\n            }\r\n            return info;\r\n        },\r\n        switchDrawHtmlMethod: function(tplInfo){\r\n    \r\n            // マトリックス作成メソッド\r\n            if(tplInfo.path['eir-matrix-fullyear']){\r\n                return 'matrix_fullyear';\r\n            }\r\n            else if(tplInfo.path['eir-matrix-quarter']){\r\n                return 'matrix_quarter';\r\n            }\r\n            //カレンダーテーブル作成メソッド\r\n            else if(tplInfo.path['eir-calendar']){\r\n                return 'calendar_table';\r\n            }\r\n    \r\n            switch(tplInfo.path['loop-item'].join(', ')){\r\n                // 年、四半期、ニュースタイプ、item\r\n                case 'loop-news-type, loop-quarter, loop-year':\r\n                    return 'level4YearQuarterNewsType';\r\n    \r\n                // 年、ニュースタイプ、四半期、item\r\n                case 'loop-quarter, loop-news-type, loop-year':\r\n                    return 'level4YearNewsTypeQuarter';\r\n    \r\n                // 年、四半期、item\r\n                case 'loop-quarter, loop-year':\r\n                    return 'level3YearQuarter';\r\n    \r\n                // 年、ニュースタイプ、item\r\n                case 'loop-news-type, loop-year':\r\n                    return 'level3YearNewsType';\r\n    \r\n                // 年、item\r\n                case 'loop-year':\r\n                    return 'level3YearQuarter';\r\n\r\n                // 株主総会、個人投資家向け説明会等の表作成\r\n                case 'loop-year, e