            "text": "/**\r\n* EIR Javascript v1.4.0\r\n* DATE: 2021-06-10\r\n*/\r\n\r\n(function(_e, $){\r\n\r\n    var main = {\r\n    \r\n        $head: $('head'),\r\n        \r\n        data:{},\r\n    \r\n        controllerMemo: {\r\n            year: {},\r\n            newsType: {}\r\n        },\r\n    \r\n        masterConf: {},\r\n    \r\n        pageExtend: {\r\n            conf:{}\r\n        },\r\n        \r\n        areaArr: [],\r\n        \r\n        pageTemplateAreaArr: [],\r\n\r\n        guidTextAreaArr: [],\r\n\r\n        $tmpDiv: $('<div></div>'),\r\n\r\n        $tmpTbl: $('<tbody></tbody>'),\r\n\r\n        getArea: function(index){\r\n            if(_e.isSet(index)){\r\n                return this.areaArr[index];\r\n            }\r\n            return this.areaArr;\r\n        },\r\n\r\n        getPageTemplateArea: function(index){\r\n            if(_e.isSet(index)){\r\n                return this.pageTemplateAreaArr[index];\r\n            }\r\n            return this.pageTemplateAreaArr;\r\n        },\r\n\r\n        getGuidTextAreaArr: function(index){\r\n            if(_e.isSet(index)){\r\n                return this.guidTextAreaArr[index];\r\n            }\r\n            return this.guidTextAreaArr;\r\n        },\r\n        \r\n        getAreaIndex: function(areaName){\r\n            var arr = _e.areaArr;\r\n            for(var a = 0, alen = arr.length; a < alen; a++){\r\n                if(arr[a].areaName === areaName){\r\n                    return a;\r\n                }\r\n            }\r\n            return -1;\r\n        },\r\n        \r\n        getCurrentFY: function(){\r\n            return _e.currentFY;\r\n        },\r\n    \r\n        getCurrentQuarter: function(){\r\n            return _e.curretnQuarter;\r\n        },\r\n    \r\n        getEnvLanguage: function(){\r\n            return _e.env.language;\r\n        },\r\n    \r\n        getEirCode: function(){\r\n          return _e.env.eirCode;  \r\n        },\r\n    \r\n        getEirUrl: function(){\r\n            return _e.env.eirUrl;\r\n        },\r\n    \r\n        getEnvLevel: function(){\r\n            return _e.env.level;\r\n        },\r\n    \r\n        getScriptName: function(){\r\n            return _e.env.scriptName;\r\n        },\r\n    \r\n        getEirPass: function(arg){\r\n            return arg ? _e.env.eirPass + arg : _e.env.eirPass;\r\n        },\r\n    \r\n        getEirPassCore: function(arg){\r\n            return arg ? _e.env.eirPassCore + arg : _e.env.eirPassCore;\r\n        },\r\n    \r\n        getEirPassApp: function(arg){\r\n            return arg ? _e.env.eirPassApp + arg : _e.env.eirPassApp;\r\n        },\r\n    \r\n        getStrings: function(){\r\n            var lang = _e.getEnvLanguage();\r\n            return _e.strings[lang];\r\n        },\r\n\r\n        eirMain: function(){\r\n    \r\n            this.queryMap = _e.parseUrlQuery();\r\n    \r\n            this.margeJsonData();\r\n\r\n            this.removeDummyData();\r\n\r\n            _e.hook.do('preSetupMasterConf', [this.data]);\r\n    \r\n            // 設定ツールで作成されたconfigを整える\r\n            this.setupMasterConfig();\r\n            this.initJsonData(this.data);\r\n    \r\n            _e.hook.do('preCreteArea', [this.data, this.masterConf]);\r\n    \r\n            // HTML上の.eirArea要素をすべて取得し、その数だけareaオブジェクトを作成する\r\n            this.createAreas();\r\n    \r\n            _e.hook.do('completeCreateAllAreas');\r\n    \r\n            for(var a = 0, alen = this.areaArr.length; a < alen; a++){\r\n                \r\n                _e.hook.do('preMakeDataForArea', [this.areaArr[a]]);\r\n                this.makeDataForDisplay(this.areaArr[a]);\r\n    \r\n                _e.hook.do('preDrawHtmlToArea', [this.areaArr[a]]);\r\n                this.drawHtmlToArea(this.areaArr[a]);\r\n    \r\n                _e.hook.do('completeDrawHtmlToOneArea', [this.areaArr[a]]);\r\n            }\r\n    \r\n            // HTML上にターゲットになる要素が存在する場合に描写する\r\n            this.drawHtmlToPage();\r\n        },\r\n    \r\n        // _e.areaArrにareaオブジェクトを追加する\r\n        // areaオブジェクトは取得できた要素の数だけ作成する\r\n        createAreas: function(areaName){\r\n            var $eirArea = areaName ? $('<div id=\"' + areaName + '\"></div>') : $(_e.areaSelecter),\r\n                $rootElement,\r\n                area,\r\n                areaName;\r\n    \r\n            $eirArea.each(function(index){\r\n                $rootElement = $(this);\r\n                areaName = $rootElement.attr('data-area-name');\r\n                area = {\r\n                   $rootElement: $rootElement,\r\n                   $dataRootElement: $(_e.htmlTemplate.dataArea),\r\n                   $anchorLinkRoot:  $('<div></div>'),\r\n                   areaName: areaName,\r\n                   controllers: {}\r\n                }\r\n    \r\n                _e.hook.do('preMakeAreaConf', [area]);\r\n    \r\n                // confを取得\r\n                area.conf = _e.makeConfigForArea(area.areaName);\r\n    \r\n                // エリア名をクラスとして付与\r\n                if(!$rootElement.hasClass(areaName)){\r\n                        $rootElement.addClass('eir_area_' + areaName);\r\n                }\r\n                // ページ名をクラスとして付与\r\n                if(!$rootElement.hasClass(area.conf.templateName)){\r\n                        $rootElement.addClass('eir_page_' + _e.env.scriptName);\r\n                }\r\n                \r\n                if(area.conf.areaType.name === 'page_template'){\r\n                    // item.textを用いて静的ページを作成するエリア\r\n                    $rootElement.addClass('eirUseText eirUseText_pageTemplate');\r\n                    _e.pageTemplateAreaArr.push(area);\r\n                    new PageTemplate().main(area, _e.data);\r\n                }\r\n                else if(area.conf.areaType.name === 'guid_text'){\r\n                    // 指定のguidのitem.textを表示するエリア\r\n                    _e.guidTextAreaArr.push(area);\r\n                    new _e.GuidText().main(area, _e.data);\r\n                }\r\n                else{\r\n                    // 書類のリストを作成するエリア\r\n                    _e.hook.do('preMakeDateForArea', [area]);\r\n    \r\n                    // エリアの母数のitemを取得\r\n                    area.data = _e.makeDataForArea(_e.data, area);\r\n    \r\n                    // groupType毎のメソッドを取得\r\n                    area.groupTypeMethods = _e.getGroupTypeMethods(area);\r\n    \r\n                    _e.hook.do('preMakeGroupArr', [area]);\r\n\r\n                    // 年配列情報を再作成\r\n                    _e.addAreaDataGroup(area.data, area.conf);\r\n    \r\n                    // yearGroupArrからgroupArrを作成する\r\n//                     area.data.groupArr = _e.makeGroupArrForArea(area);    \r\n                   _e.areaArr.push(area);\r\n                }\r\n            });\r\n\r\n            _e.hook.do('preCreateController', [area]);\r\n    \r\n            _e.createController();\r\n                            \r\n            _e.hook.do('completeCreateOneArea', [area]);\r\n        },\r\n    }\r\n    $.extend(_e, main);\r\n    \r\n    function Hook(){}\r\n    $.extend(Hook.prototype, {\r\n        add: function(type, callback){\r\n            this[type][this[type].length] = callback;\r\n        },\r\n        do: function(type, arg){\r\n            var hooks = this[type];\r\n            if(_e.isSet(hooks)){\r\n                for(var h = 0, len = hooks.length; h < len; h++){\r\n                    hooks[h](arg);\r\n                }\t\t\t\r\n            }\r\n        },\r\n        existCallback: function(type){\r\n            return _e.isSet(this[type]);\r\n        },\r\n        preSetupMasterConf: [],     // masterConfオブジェクトの調整前　→　dataが渡される\r\n        preCreteArea: [],           // areaオブジェクト作成前　→　\r\n        preMakeAreaConf: [],        // 個々のareaオブジェクト作成過程の、confオブジェクト作成前に実行される　→　エリアが渡される\r\n        preMakeDateForArea: [],      // 個々のareaオブジェクト作成過程の、data作成前に実行される　→　\r\n        preMakeGroupArr: [],        // 個々のareaオブジェクト作成過程の、groupArr作成前に実行される\r\n        preCreateController: [],    // 個々のareaオブジェクト作成過程の、コントローラ作成前に実行される\r\n        completeCreateOneArea: [],  // 個々のareaオブジェクトが作成された時に実行する\r\n        completeAllCreateAreas: [], // 全てのエリアオブジェクトが作成されたタイミングで実行される\r\n        preMakeDataForArea: [],     // \r\n        preDrawHtmlToArea: [],      // エリアに対してHTMLを描写する前に実行される\r\n        preDrawHtmlToDataArea: [],\r\n        completeDrawHtmlToOneArea: []\r\n    });\r\n    \r\n    $.extend(_e, {hook: new Hook});\r\n    \r\n    /**\r\n    * サイト全体設定の初期化\r\n    *\r\n    * @method setupMasterConfig\r\n    */\r\n    _e.setupMasterConfig = function(){\r\n    \r\n        // キーワード\r\n        for(var k = 0, kLen = _e.keyword.length; k < kLen; k++){\r\n            for(var v = 0, vLen = _e.keyword[k].value.length; v < vLen; v++){\r\n                _e.keyword[k].value[v] = new RegExp(_e.keyword[k].value[v]);\r\n            }\r\n            // strginをbooleanに変更\r\n            switch(_e.keyword[k].notReverseRetVal){\r\n                case 'true':\r\n                    _e.keyword[k].notReverseRetVal = true;\r\n                    break;\r\n                case 'false':\r\n                    _e.keyword[k].notReverseRetVal = false;\r\n                    break;\r\n            }\r\n        }\r\n\r\n        // カスタムニュースタイプ\r\n        for(var c = 0, clen = _e.customContentsId.length; c < clen; c++){\r\n            var obj = _e.customContentsId[c];\r\n\r\n            // 初期状態では、obj.keywordはString(名前参照の名前)の配列となっている\r\n            // それをキーワードオブジェクトの配列に変える\r\n            if(_e.isSet(obj.keyword) && _e.typeOf(obj.keyword[0]) === 'string'){\r\n                obj.keyword = _e.fetchKeywordConfByName(obj.keyword);\r\n            }\r\n\r\n            // strginをbooleanに変更\r\n            switch(obj.overwriteNewstype){\r\n                case 'true':\r\n                    obj.overwriteNewstype = true;\r\n                    break;\r\n                case 'false':\r\n                    obj.overwriteNewstype = false;\r\n                    break;\r\n            }\r\n        }\r\n        \r\n        // ニュースタイプコントローラ\r\n        for(var n = 0, nLen = _e.generalNtCtrlConfs.length; n < nLen; n++){\r\n            jsTextToFuncObj(_e.generalNtCtrlConfs[n].groupArr);\r\n        }\r\n\r\n        // 年タイプコントローラ\r\n        for(var n = 0, nLen = _e.generalYCtrlConfs.length; n < nLen; n++){\r\n            jsTextToFuncObj(_e.generalYCtrlConfs[n].groupArr);\r\n            for(var c = 0, clen = _e.generalYCtrlConfs[n].customType.length; c < clen; c++){\r\n                // strginをbooleanに変更\r\n                switch(_e.generalYCtrlConfs[n].customType[c].enable){\r\n                    case 'true':\r\n                        _e.generalYCtrlConfs[n].customType[c].enable = true;\r\n                        break;\r\n                    case 'false':\r\n                        _e.generalYCtrlConfs[n].customType[c].enable = false;\r\n                }\r\n            }\r\n        }\r\n    \r\n        // V4の設定ツールで作成された設定をV5スクリプトに合わせる\r\n        if((window.__generatorVersion === '1.0.1' || window.__generatorVersion === '1.0.0') && _e.useV4Config){\r\n            _e.v4ConfToV5Conf(_e.masterConf);\r\n            $.extend(true, _e.masterConf, _e.pageExtend.conf.v4Tov5);\r\n        }\r\n        for(var c = 0, clen = _e.catIcons.length; c < clen; c++){\r\n            jsTextToFuncObj(_e.catIcons[c].icons);\r\n        }\r\n    };\r\n    \r\n    /**\r\n    * エリア個別の設定値を初期化する\r\n    *\r\n    * @method makeConfigForArea\r\n    * @param {String} areaName\r\n    * @return {Object} areaConf\r\n    */\r\n    _e.makeConfigForArea = function(areaName){\r\n        \r\n        if(!_e.isSet(this.pageExtend.conf[areaName])){\r\n            throw new Error('confが設定されていません [areaName: ' + areaName + ']');\r\n        }\r\n        \r\n        var areaConf = this.pageExtend.conf[areaName];\r\n    \r\n        // キーワードの名前参照をオブジェクト化する\r\n        areaConf.data.keyword.groupArr = _e.fetchKeywordConfByName(areaConf.data.keyword.groupArr);\r\n\r\n        // 通期と判定するテキストを正規表現オブジェクトにする\r\n        areaConf.groupTypes.fyByTitle.fullYearReg = new RegExp(areaConf.groupTypes.fyByTitle.fullYearReg);\r\n\r\n        // 新着アイコンの設定値はマイナスである必要がある\r\n        areaConf.data.newIcon.limit = Number(areaConf.data.newIcon.limit);\r\n        if(areaConf.data.newIcon.limit >= 0){\r\n            areaConf.data.newIcon.limit = areaConf.data.newIcon.limit * -1;\r\n        }\r\n    \r\n        // StringになっているjsのテキストをFunctionオブジェクトにする\r\n        jsTextToFuncObj(areaConf.controller.newsType.groupArr);\r\n    \r\n        // カテゴリアイコンオブジェクトをエリア設定に紐付ける\r\n        var catIconConf = _e.serchObjectInnerArr(_e.catIcons, 'name', areaConf.data.catIcon.name);\r\n        if(catIconConf[0]){\r\n            areaConf.data.catIcon.icons = catIconConf[0].icons;\t\r\n        }\r\n    \r\n        // StringになっているjsのテキストをFunctionオブジェクトにする\r\n        jsTextToFuncObj(areaConf.data.catIcon.icons);\r\n    \r\n        // ニュースタイプコントローラのjavascript\r\n        jsTextToFuncObj(areaConf.controller.newsType.groupArr);\r\n\r\n        if(_e.isEmpty(_e.htmlTemplate.list[areaConf.htmlTemplate])){\r\n            throw new SyntaxError('エリア設定のタグ構造テンプレートが存在しません[エリア名: ' + areaName + ']' + '[htmlTemplate名: ' + areaConf.htmlTemplate + ']');\r\n        }\r\n\r\n        return this.pageExtend.conf[areaName];\r\n    };\r\n    function jsTextToFuncObj(groupArr){\r\n        var group;\r\n        for(var i in groupArr){\r\n            group = groupArr[i];\t\r\n            if(_e.typeOf(group.javascript) === 'string'){\r\n                    group.javascript = new Function('item', group.javascript);\r\n            }\r\n        }\r\n    }\r\n\r\n    /**\r\n    * v4の設定ツールの項目をv5の設定で再現できるようにする\r\n    *\r\n    * @method useV4Config\r\n    * @param {Object} config用のオブジェクト\r\n    * @return {Object} areaConf\r\n    */\r\n   _e.v4ConfToV5Conf = function(c){\r\n        \r\n        // CSSの読込み\r\n        c.readCss = cssFlg;\r\n\r\n        // RSS、有報CSV、注記など\r\n        c.rss.partsNumber = rssNo;\r\n        c.rss.enable = rssFlg;\r\n        c.pdfNote.enable = pdfFlg;\r\n        c.pnexNote.enable = pdfFlg;\r\n        // CSVはyuhoパーツの番号を別途指定する必要あり\r\n        c.yuhoCsv.enable = csvFlg;\r\n\r\n        // ニュースタイプ制御\r\n        c.controller.newsType = {\r\n            enable: tabFlg,\r\n            name: 'master',\r\n            branchTab: branchTab,\r\n            viewArea: '',\r\n            htmlTemplate: 'button',\r\n            tabArr: tabArr,\r\n        }\r\n\r\n        // 年制御\r\n        switch(yearList){\r\n            case 0:\r\n                c.controller.year.enable = true;\r\n                c.controller.year.htmlTemplate = 'button';\r\n            break;\r\n            case 1:\r\n                c.controller.year.enable = true;\r\n                c.controller.year.htmlTemplate = 'pullDown';\r\n            break;\r\n        }\r\n        // 【WARNING】lastest, allItemに関しては設定構造の変更可能性有り\r\n        if(lastest){\r\n            c.groupTypes.custom.push('dateYearLimit');\r\n            c.controller.dateYearLimit = 1;\r\n        }\r\n        if(allItem){\r\n            c.groupTypes.custom.push('allItem');\r\n        }\r\n\r\n        // アンカーリンク\r\n        c.data.reDrawHtml.anchorLink.enable = ancFlg;\r\n        if(ancForPast){\r\n            c.data.reDrawHtml.anchorLink.position = 1;\r\n        }\r\n\r\n        // 年見出し\r\n        c.data.headFlg = headFlg;\r\n        \r\n        // 年グループ\r\n        if(fyFlg){\r\n            c.groupTypes.year = {\r\n                year: 'fiscal_ym',\r\n                fyByTitle: {\r\n                    enable: fyFiscalYm,\r\n                    month: fClosingMonth\r\n                },\r\n                custom: []\r\n            }\r\n            c.groupTypes.year = 'fiscal_ym';\r\n        }\r\n\r\n        // item数制限\r\n        if(irTop){\r\n            c.data.itemCountRange = {\r\n                enable: true,\r\n                begin: 0,\r\n                end: newNum,\r\n            }\r\n        }\r\n\r\n        // 表示期数制限\r\n        if(limitYear){\r\n            c.data.groupCountRange = {\r\n                enable: true,\r\n                begin: 0,\r\n                end: yearNum,\r\n            }\r\n        }\r\n\r\n        // キーワード制御\r\n        c.data.viewType = viewType;\r\n        for(var k = 0, len = keyWord.length; k < len; k++){\r\n            if(_e.typeOf(keyWord[k]) === 'string'){\r\n                c.data.keyword.push({\r\n                            news_type: [],\r\n                            value: [keyWord[k]],\r\n                            condition: 'AND',\r\n                            action: 'HIDE'\r\n                        });    \t\t\r\n            }\r\n        }\r\n        // 特殊資料\r\n        c.data.id240Flg = id240Flg;\r\n        c.data.id310Flg = id310Flg;\r\n        c.data.id320Flg = id320Flg;\r\n        c.data.id330Flg = id330Flg;\r\n\r\n        // コメント非表示\r\n        c.data.hiddenComment = hiddenComment;\r\n        \r\n        // 短信 or 有報の訂正\r\n        c.data.tanshinTeisei = tanshinTeisei;\r\n        c.data.yuhoTeisei = yuhoTeisei;\r\n\r\n        // 有報過去分\r\n        c.data.yuhoBack = yuhoBack;\r\n        c.data.yuhobackList = yuhobackList;\r\n\r\n        // グループ最新1件\r\n        if(irGovernance){\r\n            c.data.itemCountEachGroup = {\r\n                enable: true,\r\n                limit: 1\r\n            }\r\n        }\r\n\r\n        // カレンダーモード\r\n        c.calendarMode = irCalendar;\r\n\r\n        // guidを指定して静的HTMLページをitem.textで作成する\r\n        if(irText){\r\n            c.data.useText = 'guidLink';\r\n            c.data.textHtmlPath = textUrl;\r\n        }\r\n\r\n        // itemのタイトルの西暦和暦の統一\r\n        c.data.itemS2W = s2w;\r\n        if(seiwa){\r\n            c.data.seiwa = 'SEIREKI';\r\n        }else{\r\n            c.data.seiwa = 'WAREKI';\r\n        }\r\n\r\n        // itemのタイトルの英数字の半角全角統一する\r\n        c.data.z2h = z2h;\r\n    \r\n        // 新着アイコン\r\n        c.data.newIcon = {\r\n            enable: NewIconFlg,\r\n            limit: NewIconLimit\r\n        }\r\n\r\n        // サムネイル\r\n        c.data.thumbFlg = thumbFlg;\r\n\r\n        // itemの日付、カテゴリアイコンの表示非表示\r\n        c.data.itemHead = dtFlg;\r\n\r\n        // カテゴリアイコン\r\n        c.data.catIcon = catIcon;\r\n        c.data.getCategoryIconText = GetCategoryIconText;\r\n        c.data.getCategoryIconClass = GetCategoryIconClass;\r\n        c.__generatorVersion = __generatorVersion;\r\n    };\r\n    \r\n    /**\r\n    * itemの配列をソートする\r\n    * ソートの優先順位の設定は 「order > conf > デフォルト」の順に決定される\r\n    *\r\n    * @method sortItems\r\n    * @param {Object} item\r\n    * @param {Object} conf\r\n    */   \r\n    _e.sortItems = function(items, conf, order){\r\n        var compareFuncs = [];\r\n        order = order || conf.data.sort.order;\r\n        \r\n        // ソートの優先順位が指定されていない時\r\n        if((order && order.length === 0) || !order){\r\n            if(conf.data.viewType.length === 1){\r\n                order = ['group_order', 'date'];\r\n            }\r\n            else{\r\n                order = ['date'];\r\n            }\r\n        }\r\n\r\n        for(var o = 0, olen = order.length; o < olen; o++){\r\n            if(_e.isEmpty(_e.sortHelper[order[o]]) && _e.debug){\r\n                throw new Error('ソートの順番を決めるメソッド（sortHelper.' + order[o] + '）が見つかりません');\r\n            }\r\n            compareFuncs[compareFuncs.length] = _e.sortHelper[order[o]];\r\n        }\r\n\r\n        items.sort(function(a, b) {\r\n            for(var c = 0, clen = compareFuncs.length; c < clen; c++){\r\n                var num = compareFuncs[c](a, b, conf);\r\n                if(_e.typeOf(num) === 'number'){\r\n                    return num;\r\n                }\r\n            }\r\n            return 0;\r\n        });\r\n    };\r\n    \r\n    // JSONからareaに必要なitemを抽出する\r\n    var makeData = {\r\n        margeJsonData: function(){\r\n            if(!_e.env.testMode){\r\n                this.data.item = this.data.item.concat(this.dataExtend.item);\r\n                this.data.yuho_back = this.data.yuho_back.concat(this.dataExtend.yuho_back);  \r\n            }\r\n        },\r\n\r\n        removeDummyData: function(){\r\n            if(_e.env.level == \"public\"){\r\n                this.data.item = this.data.item.filter(function (item){\r\n                    return !/【PNEXダミー】/.test(item.title.replace(/\\s/g, '').toUpperCase());\r\n                });\r\n            }\r\n        },\r\n\r\n        /**\r\n        * ロードしたばかりの何も手が加わっていないJSONをV5スクリプト用に値を変更、追加する\r\n        *\r\n        * @method initJsonData\r\n        * @param {Object} jsonData\r\n        */\r\n        initJsonData: function(jsonData){\r\n            var items = [].concat(jsonData.item),\r\n                items = items.concat(jsonData.yuho_back),\r\n                item;\r\n            for(var i = 0, len = items.length; i < len; i++){\r\n                item = items[i];\r\n\r\n                // id240(英文資料)のnews_typeを変更する\r\n                if(item.sub_type === 'id240'){\r\n                    item.news_type = 'en_press';\r\n                }                            \r\n                // 短信に決算期情報が無い場合、適時開示扱いとする\r\n                if(item.news_type==='tanshin'&&item.fiscal_ym===''){\r\n                    item.news_type='press';\r\n                }\r\n\r\n                // カスタムニュースタイプ\r\n                // 条件に合致したitemのsub_typeを書き換える\r\n                for(var c = 0, clen = _e.customContentsId.length; c < clen; c++){\r\n                    var obj = _e.customContentsId[c];\r\n                    \r\n                    // キーワード判定オブジェクトを取得する\r\n                    var myKeywordConfs = _e.filterMyKeywordConfs(item, obj.keyword);\r\n\r\n                    if(_e.isSet(myKeywordConfs) && _e.keywordMatch(item, myKeywordConfs)){\r\n                        item.pre_sub_type = item.sub_type;\r\n                        item.sub_type  = obj.subType;\r\n                        if(obj.overwriteNewstype){\r\n                            item.pre_news_type = item.news_type;\r\n                            item.news_type  = 'custom_type';\r\n                        }\r\n                    }\r\n                }\r\n\r\n                // 追加書類に親itemのプロパティ付与\r\n                if(Number(item.attachment_count) > 0){\r\n                    _e.addParentPropToAttachmentItem(item);\r\n                }\r\n\r\n                // 四半期の値を変換する\r\n                switch(item.quarter){\r\n                    case '0':\r\n                        item.quarter = '100';\r\n                        break;\r\n                    case '9':\r\n                        item.quarter = item.quarter;\r\n                        break;\r\n                    case '':\r\n                        break;\r\n                    default:\r\n                        item.quarter = item.quarter + '0';\r\n                }\r\n\r\n                // 暦年、事業年度用などのプロパティ追加\r\n                _e.customYearType.do(item);\r\n\r\n    \r\n                // group_orderの型を数値とする、初期値を設定する\r\n                if(item.group_order === ''){\r\n                    item.group_order = 99999;\r\n                }\r\n                else{\r\n                    item.group_order = Number(item.group_order);\r\n                }\r\n    \r\n                // サムネイルのSSL対応\r\n                if(_e.isHttpsLocation() && item.thumbnail_link){\r\n                    item.thumbnail_link = _e.toSslPath(item.thumbnail_link);\r\n                }\r\n    \r\n                // アンエスケープ\r\n                if(item.comment){\r\n                    item.comment = _e.decodeText(item.comment);\t\r\n                }\r\n                if(item.text){\r\n                    item.text = _e.decodeText(item.text);\r\n                }\r\n                item.title = _e.decodeText(item.title);\r\n\r\n                // 現在の四半期、決算期を保持する変数を作成する\r\n                if(item.news_type === 'tanshin' && _e.isSet(item.fiscal_ym) && !jsonData.currentFY  && !jsonData.currentQuarter){\r\n                    jsonData.currentFY = item.fiscal_ym;\r\n                    jsonData.currentQuarter = item.quarter;\r\n                    jsonData.currentResourceItem = item;\r\n                }\r\n            }\r\n        },\r\n    \r\n    \r\n        /**\r\n        * JSONのitemからareaに必要なitemを抽出する\r\n        * また、そのitemのメタデータ（グループの配列など）を作成する\r\n        *\r\n        * @method makeDataForArea\r\n        * @param {Object} jsonData\r\n        * @param {Object} area\r\n        * @return {Object} areaData\r\n        */\r\n        makeDataForArea: function(jsonData, area){\r\n            var conf = area.conf,\r\n                yearGroupType = conf.groupTypes.year,\r\n                allItems = jsonData.item,\r\n                item,\r\n                areaData = { \r\n                    yearGroupArr: [],\r\n                    v4commentTableArr: [],\r\n                    items: [],\r\n                    yuhoTeisei: [],\r\n                    tanshinTeisei: [],\r\n                    yuhoBack: jsonData.yuho_back\r\n                },\r\n                viewFlg;\r\n    \r\n            if(conf.data.yuhoBack){\r\n                _e.setYuhoBack(areaData, area);\r\n            }\r\n\r\n            for(var i = 0, ilen = allItems.length; i < ilen; i++){\r\n                item = allItems[i];\r\n                viewFlg = false;\r\n                \r\n                // 短信訂正\r\n                if(_e.isTanshinTeisei(item)){\r\n                    if(conf.data.tanshinTeisei){\r\n                        item.fiscal_ym = _e.title2Fy.do(item);\r\n                        item.quarter = _e.title2Quarter.do(item, /決算短信/);\r\n                        areaData.tanshinTeisei[areaData.tanshinTeisei.length] = item;\r\n                        continue;\r\n                    }\r\n                }\r\n                // 有報訂正\r\n                if(_e.isYuhoTeisei(item)){\r\n                    if(conf.data.yuhoTeisei){\r\n                        areaData.yuhoTeisei[areaData.yuhoTeisei.length] = item;\r\n                    }\r\n                    continue;\r\n                }\r\n\r\n                // news_type, sub_type\r\n                if(_e.isSet(conf.data.viewType)){\r\n                    if(!this.isExpectNewsTypeItem(item, conf.data.viewType, conf.idTypes)){\r\n                        continue;\r\n                    }\r\n                }\r\n                // キーワード\r\n                if(conf.data.keyword.enable && _e.isSet(conf.data.keyword.groupArr)){\r\n                    var myKeywordConfArr = _e.filterMyKeywordConfs(item, area.conf.data.keyword.groupArr);\r\n                    if(_e.isSet(myKeywordConfArr) && !_e.validKeyword(item, myKeywordConfArr)){\r\n                        continue;\r\n                    }\r\n                }\r\n                // 日付\r\n                if(conf.data.date.enable){\r\n                    if(!_e.validDate(item, area)){\r\n                        continue;\r\n                    }\r\n                }\r\n                // 四半期情報等付与\r\n                _e.addItemDataQuarter(item, area.conf);\r\n                // 決算期\r\n                if(conf.data.fiscal_ym.enable){\r\n                    if(!_e.validFiscalYm(item, area)){\r\n                        continue;\r\n                    }\r\n                }\r\n\r\n                // テキスト入力時非表示\r\n                if(conf.data.hideItemWithText){\r\n                    if(item.text != ''){\r\n                        continue;\r\n                    }\r\n                }\r\n\r\n                // v4の仕様を引継ぐ\r\n                // コメントから表を生成\r\n                if(conf.data.v4commentTable){\r\n                    var commentArr = (/<br\\/>/.test(item.comment))?item.comment.split('<br/>'):[];\r\n                    if(commentArr.length){\r\n                        areaData.v4commentTableArr[item.group_name] = _e.getCommentTable(commentArr);\r\n                    }                    \r\n                }\r\n\r\n                areaData.items[areaData.items.length] = item;\r\n            }\r\n            // 四半期情報等付与\r\n            _e.addAreaDataQuarter(areaData, area.conf);\r\n\r\n            // ソート\r\n            this.sortItems(areaData.items, area.conf);\r\n    \r\n            // 文脈が必要な選び方は、個別にitemをすべて渡した方がやりやすい\r\n            // フィルタ系のメソッドは全てandで実行される            \r\n            areaData = _e.reMakeDataByItemFilter(areaData, area);\r\n\r\n            if(conf.data.schedule.enable){\r\n                areaData = _e.reMakeDataBySchedule(areaData, area);\r\n            }\r\n            if(conf.data.itemCountRange.enable && !conf.controller.newsType.enable){\r\n                areaData = _e.reMakeDataByItemCountRange(areaData, area);\r\n            }\r\n            if(conf.data.quarterCountRange.enable){\r\n                areaData = _e.reMakeDataByQuarterCountRange(areaData, area);\r\n            }\r\n\r\n            // 年配列情報等付与\r\n            _e.addAreaDataGroup(areaData, area.conf);\r\n\r\n            if(conf.data.groupCountRange.enable){\r\n                areaData = _e.reMakeDataByGroupCountRange(areaData, area);\r\n            }\r\n            if(conf.data.itemCountEachGroup.enable){\r\n                areaData = _e.reMakeDataByItemCountEachGroup(areaData, area);\r\n            }\r\n            if(conf.data.itemCountEachViewType && conf.data.itemCountEachViewType.enable){\r\n                areaData = _e.reMakeDataByItemCountEachViewType(areaData, area);\r\n            }\r\n            \r\n            // JSONデータへitemを参照するのではなく、個別にインスタンスを持つ\r\n            _e.itemObjToNewObj(areaData);\r\n\r\n            // 追加書類を切り離す\r\n            if(!area.conf.data.attachment.enable){\r\n                _e.removeAttachmentItemFromArea(areaData);\r\n            }\r\n\r\n            // 訂正書類を親書類に紐付ける\r\n            if(conf.data.tanshinTeisei){\r\n                _e.attachTeisei(areaData, 'tanshin');\r\n            }\r\n            if(conf.data.yuhoTeisei){\r\n                _e.attachTeisei(areaData, 'yuho');\r\n            }\r\n\r\n            return areaData;\r\n        },\r\n\r\n        removeAttachmentItemFromArea: function(areaData){\r\n            for(var i = 0, len = areaData.items.length; i < len; i++){\r\n                areaData.items[i].attachment.length = 0;\r\n                areaData.items[i].attachment_count = '0';\r\n            }\r\n            return areaData;\r\n        },\r\n\r\n        itemObjToNewObj: function(areaData){\r\n            for(var i = 0, len = areaData.items.length; i < len; i++){\r\n                areaData.items[i] = $.extend(true, {}, areaData.items[i]);\r\n            }\r\n        },\r\n    \r\n        /**\r\n        * 訂正書類を親書類に紐付ける\r\n        *\r\n        * @method attachTeisei\r\n        * @param {Object}\r\n        * @param {Object}\r\n        * @return {Object}\r\n        */\r\n        attachTeisei: function(areaData, type){\r\n            var mainItems = areaData.items, \r\n                mainItem, // 親書類\r\n                subItems = type === 'tanshin' ? areaData.tanshinTeisei : areaData.yuhoTeisei,\r\n                subItem; // 訂正書類\r\n    \r\n            for(var m = 0, mlen = mainItems.length; m < mlen; m++){\r\n                mainItem = mainItems[m];\r\n                if(mainItem.news_type !== type){\r\n                    continue;\r\n                }\r\n                \r\n                for(var s = 0, slen = subItems.length; s < slen; s++){\r\n                    subItem = subItems[s];\r\n                \r\n                    if(_e.teiseiHantei(mainItem, subItem, type)){\r\n                        if(!mainItem.teisei){\r\n                            mainItem.teisei = [];\r\n                        }\r\n                        mainItem.teisei.push(subItem);\r\n                    }\r\n                }\r\n            }\r\n        },\r\n    \r\n        /**\r\n        * subItemがmainItemの訂正書類かどうかを判定する\r\n        *\r\n        * @method teiseiHantei\r\n        * @param {Object}\r\n        * @param {Object}\r\n        * @return {Object}\r\n        */\r\n        teiseiHantei: function(mainItem, subItem, type){\r\n            if(type === 'tanshin'){\r\n    \r\n                var mainItemTitle = _e.makeTtl(mainItem);\r\n                var subItemTitle = _e.makeTtl(subItem);\r\n    \r\n                // 元書類に「個別」が含まれているか判定\r\n                if(/個別/.test(mainItemTitle)){\r\n                    if(!/個別/.test(subItemTitle)){\r\n                        return false;\r\n                    }\r\n                }\r\n                else{\r\n                    if(/個別/.test(subItemTitle)){\r\n                        return false;\r\n                    }\r\n                }\r\n    \r\n                // 決算期と四半期が一致\r\n                var subFy = subItem.fiscal_ym,\r\n                    subQ = subItem.quarter,\r\n                    mainFy = mainItem.fiscal_ym,\r\n                    mainQ = mainItem.quarter;\r\n    \r\n                if(subFy === mainFy && subQ === mainQ){\r\n                    return true;    \r\n                }           \r\n            }\r\n            else if(type === 'yuho'){\r\n                if(subItem.parent_tray_code.length > 0){ // 「parent_tray_code」が存在するとき\r\n                    if(subItem.parent_tray_code === mainItem.tray_code){ // 「parent_tray_code」と「tray_code」が一致\r\n                        return true;    \r\n                    }\r\n                }       \r\n            }\r\n            return false;\r\n        },\r\n    \r\n        // 指定のニュースタイプを持つitemだった場合はtrueを返す\r\n        isExpectNewsTypeItem: function(item, expectNewsTypes, expectIdTypes){\r\n            switch(item.news_type){\r\n                case 'ir_material':\r\n                case 'ir_material_for_fiscal_ym':\r\n                case 'announcement':\r\n                case 'calendar':\r\n                if(expectNewsTypes.indexOf(item.sub_type) > -1){\r\n                    return true;\r\n                }\r\n                break;\r\n    \r\n                case 'press':\r\n                case 'pr':\r\n                case 'cgr_ds':\r\n                case 'cgr_do':\r\n                case 'gms':\r\n                if(expectIdTypes && expectIdTypes.indexOf(item.sub_type) > -1){\r\n                    return true;\r\n                }\r\n                else{\r\n                    if(expectNewsTypes.indexOf(item.news_type) > -1 || expectNewsTypes.indexOf(item.sub_type) > -1){\r\n                        return true;\r\n                    }\r\n                }\r\n                break;  \r\n    \r\n                default:\r\n                if(expectNewsTypes.indexOf(item.news_type) > -1 || expectNewsTypes.indexOf(item.sub_type) > -1){\r\n                    return true;\r\n                }\r\n                break;\r\n            }\r\n            return false;\r\n        },\r\n        fetchKeywordConfByName: function(nameArr){\r\n            \r\n            if(_e.typeOf(nameArr[0]) === 'object'){\r\n                return nameArr;\r\n            }\r\n            // keywordオブジェクトを参照する\r\n            var tmp = [];\r\n            for(var c = 0, clen = nameArr.length; c < clen; c++){\r\n                kConf = nameArr[c];\r\n                var kConfObj = _e.serchObjectInnerArr(_e.keyword, 'name', kConf);\r\n                if(_e.isSet(kConfObj)){\r\n                    kConfObj = kConfObj[0];\r\n                    tmp.push(kConfObj);\r\n                }\r\n            }\r\n            return tmp;\r\n        },\r\n\r\n        filterMyKeywordConfs: function(item, kConfArr){\r\n            var kConf,\r\n                myConfs = [];\r\n            for(var i = 0, len = kConfArr.length; i < len; i++){\r\n                kConf = kConfArr[i];\r\n                switch(item.news_type){\r\n                    case 'ir_material':\r\n                    case 'ir_material_for_fiscal_ym':\r\n                    case 'announcement':\r\n                    case 'calendar':\r\n                        if(kConf.news_type.indexOf(item.sub_type) > -1){\r\n                            myConfs[myConfs.length] = kConf;\r\n                        }\r\n                        break;\r\n                    default:\r\n                        if(kConf.news_type.indexOf(item.news_type) > -1\r\n                        || kConf.news_type.indexOf(item.sub_type) > -1){\r\n                            myConfs[myConfs.length] = kConf;\r\n                        }\r\n                        break;\r\n                }\r\n            }\r\n            return myConfs;\r\n        },\r\n\r\n        isKeywordTargetItem: function(item, kConf){\r\n            \r\n            switch(item.news_type){\r\n                case 'ir_material':\r\n                case 'ir_material_for_fiscal_ym':\r\n                case 'announcement':\r\n                case 'calendar':\r\n                    if(kConf.news_type.indexOf(item.sub_type) > -1){\r\n                        return true;\r\n                    }\r\n                    break;\r\n                default:\r\n                    if(kConf.news_type.indexOf(item.news_type) > -1\r\n                    || kConf.news_type.indexOf(item.sub_type) > -1){\r\n                        return true;\r\n                    }\r\n                    break;\r\n            }\r\n            return false;\r\n        },\r\n\r\n        // titleに含まれるキーワードによってそのitemが有効かどうかを判定する\r\n        keywordMatch: function(item, kConfArr, callback){\r\n            var kConf,\r\n                findKeyword,\r\n                isEnableItem = true;\r\n    \r\n            for(var c = 0, clen = kConfArr.length; c < clen; c++){\r\n                kConf = kConfArr[c];\r\n\r\n                findKeyword = _e.isFindKeyword(item, kConf, callback);\r\n                \r\n                // キーワードにマッチした時にそのitemを無効にする場合もある\r\n                if(kConf.notReverseRetVal && !findKeyword){\r\n                    // 有効且つ、キーワードがマッチしなかった時\r\n                    isEnableItem = false;\r\n                    break;\r\n                }else if(!kConf.notReverseRetVal && findKeyword){\r\n                    // 無効且つ、キーワードがマッチした時\r\n                    isEnableItem = false;\r\n                    break;\r\n                }\r\n            }\r\n            return isEnableItem;\r\n        },\r\n        // キーワードが見つかるかどうかを判定する\r\n        isFindKeyword: function(item, kConf, callback){\r\n\r\n            var findKeyword = false,\r\n                news_type = kConf.news_type,\r\n                value     = kConf.value,\r\n                condition = kConf.condition || 'AND';\r\n\r\n            // 旧仕様を包括する\r\n            if(kConf.notReverseRetVal === undefined){\r\n                switch(kConf.action){\r\n                    case 'HIDE':\r\n                        kConf.notReverseRetVal = false;\r\n                        break;\r\n                    case 'SHOW':\r\n                    default:\r\n                        kConf.notReverseRetVal = true;\r\n                        break;\r\n                }\r\n            }\r\n\r\n            // キーワードがマッチするかどうか判定\r\n            findKeyword = false;\r\n            if(_e.typeOf(value) === 'array'){\r\n                if(condition === 'OR'){\r\n                    for(var v = 0, vlen = value.length; v < vlen; v++){\r\n                        if(value[v].test(item.title)){\r\n                            findKeyword = true;\r\n                            break;\r\n                        }\r\n                    }\r\n                }\r\n                else if(condition === 'AND'){\r\n                    findKeyword = true;\r\n                    for(var v = 0, vlen = value.length; v < vlen; v++){\r\n                        if(!value[v].test(item.title)){\r\n                            findKeyword = false;\r\n                            break;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n            else{\r\n                if(value.test(item.title)){\r\n                    findKeyword = true;\r\n                }\r\n            }\r\n\r\n            if(_e.typeOf(callback) === 'function'){\r\n                findKeyword = callback.apply(kConf, [item, findKeyword]);\r\n            }\r\n            if(_e.typeOf(kConf.javascript) === 'function'){\r\n                findKeyword = kConf.javascript.apply(kConf, [item, findKeyword]);\r\n            }\r\n            \r\n            return findKeyword;\r\n        },\r\n\r\n        /**\r\n        * itemのタイトルに特定のキーワードが含まれるかどうかを判定する\r\n        * キーワードが複数ある場合にANDもしくはOR条件で判定するかどうかは設定で決定される\r\n        * また、キーワードが含まれる場合にTrueもしくはFalseを返すかどうかも設定によって決定される\r\n        * 以下は設定値の構造\r\n        * {\r\n        *    news_type: string/array,\r\n        *    value: string/array\r\n        *    condition: string('OR'/'AND'),\r\n        *    action: string('SHOW'/'HIDE')\r\n        * }\r\n        *\r\n        * @method validKeyword\r\n        * @param {Object} item\r\n        * @param {Array} kConfArr\r\n        * @return {Boolean} True, 設定の条件に合致するならば\r\n        */\r\n        validKeyword: function(item, kConfArr){\r\n            return _e.keywordMatch(item, kConfArr);\r\n    \r\n        },\r\n    \r\n        /**\r\n        * itemの日付が指定の日付以降または以前かどうかを判定する\r\n        *\r\n        * @method validComment\r\n        * @param {Object} item\r\n        * @param {Object} area\r\n        * @return {Boolean} True, 設定の条件に合致するならば\r\n        */\r\n        validComment: function(item, area){\r\n            var dConf = area.conf.data.date,\r\n                beforeOrAfter = dConf.beforeOrAfter || 'AFTER';\r\n    \r\n            switch(beforeOrAfter.toUpperCase()){\r\n                case 'AFTER':\r\n                    if(Date.parse(dConf.value) <= Date.parse(item.date)){\r\n                        return true;\r\n                    }\r\n                break;\r\n    \r\n                case 'BEFORE':\r\n                    if(Date.parse(dConf.value) >= Date.parse(item.date)){\r\n                        return true;\r\n                    }\r\n                break;\r\n            }\r\n            return false;\r\n        },\r\n    \r\n        /**\r\n        * itemの日付が指定の日付以降または以前かどうかを判定する\r\n        *\r\n        * @method validDate\r\n        * @param {Object} item\r\n        * @param {Object} area\r\n        * @return {Boolean} True, 設定の条件に合致するならば\r\n        */\r\n        validDate: function(item, area){\r\n            var dConf = area.conf.data.date,\r\n                beforeOrAfter = dConf.beforeOrAfter || 'AFTER';\r\n    \r\n            switch(beforeOrAfter.toUpperCase()){\r\n                case 'AFTER':\r\n                    if(Date.parse(dConf.value) <= Date.parse(item.date)){\r\n                        return true;\r\n                    }\r\n                break;\r\n    \r\n                case 'BEFORE':\r\n                    if(Date.parse(dConf.value) >= Date.parse(item.date)){\r\n                        return true;\r\n                    }\r\n                break;\r\n            }\r\n            return false;\r\n        },\r\n        /**\r\n        * itemの決算期が指定の決算期以降または以前かどうかを判定する\r\n        *\r\n        * @method validFiscalYm\r\n        * @param {Object} item\r\n        * @param {Object} area\r\n        * @return {Boolean} True, 設定の条件に合致するならば\r\n        */\r\n       validFiscalYm: function(item, area){\r\n        var fyConf = area.conf.data.fiscal_ym,\r\n            beforeOrAfter = fyConf.beforeOrAfter || 'AFTER';\r\n\r\n        switch(beforeOrAfter.toUpperCase()){\r\n            case 'AFTER':\r\n                if(Number(fyConf.value) <= Number(item.fiscal_ym)){\r\n                    return true;\r\n                }\r\n            break;\r\n\r\n            case 'BEFORE':\r\n                if(Number(fyConf.value) >= Number(item.fiscal_ym)){\r\n                    return true;\r\n                }\r\n            break;\r\n        }\r\n        return false;\r\n    },\r\n    \r\n        /**\r\n        * 複数の条件でフィルタしdataを再作成する\r\n        *\r\n        * @method reMakeDataByItemFilter\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByItemFilter: function(data, area){\r\n            // textを持たないitemを除いてdataを再作成する\r\n            if(area.conf.data.notDisplayItemUsedText){\r\n                data.items = data.items.filter(function(item){\r\n                    return item.text.length===0;\r\n                });\r\n            }\r\n\r\n            return data;\r\n        },\r\n    \r\n        /**\r\n        * itemの配列のインデックスの範囲を指定し、その範囲のitemを基にしてdataを再作成する\r\n        *\r\n        * @method reMakeDataByItemCountRange\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByItemCountRange: function(data, area){\r\n            var range = area.conf.data.itemCountRange,\r\n                begin = range.begin ? range.begin : 0,\r\n                end   = range.end   ? range.end : data.items.length;\r\n                \r\n            var resultItems = data.items.slice(begin, end),\r\n                item;\r\n\r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n    \r\n        /**\r\n        * 四半期の配列のインデックスの範囲を指定し、その範囲の四半期を基にしてdataを再作成する\r\n        * 四半期を持つデータしか存在しないことを想定しています\r\n        *\r\n        * @method reMakeDataByQuarterCountRange\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByQuarterCountRange: function(data, area){\r\n            var range = area.conf.data.quarterCountRange,\r\n                begin = range.begin ? range.begin : 0,\r\n                end   = range.end   ? range.end : 0;\r\n    \r\n            var resultItems = [],\r\n                quarterMemo = {},\r\n                itemMemo = [],\r\n                preFiscal_ym = null,\r\n                preQuarter = null,\r\n                items = data.items,\r\n                item;\r\n                \r\n    \r\n            for(var i = 0, ilen = items.length; i < ilen; i++){\r\n                item = items[i];\r\n                if(item.quarter !== preQuarter || item.fiscal_ym !== preFiscal_ym){\r\n                    if(itemMemo.length === (begin + end)){\r\n                        break;\r\n                    }\r\n                    preFiscal_ym = item.fiscal_ym;\r\n                    preQuarter = item.quarter;\r\n                    quarterMemo = {\r\n                        name: item.fiscal_ym + ':' + item.quarter,\r\n                        items: []\r\n                    };\r\n                    itemMemo[itemMemo.length] = quarterMemo;\r\n                }\r\n                quarterMemo.items[quarterMemo.items.length] = item;\r\n            }\r\n    \r\n            itemMemo = itemMemo.slice(begin, end);\r\n            for(var i = 0, len = itemMemo.length; i < len; i++){\r\n                resultItems = resultItems.concat(itemMemo[i].items);\r\n            }\r\n    \r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n        \r\n        /**\r\n        * グループの配列のインデックスの範囲を指定し、その範囲のグループを基にしてdataを再作成する\r\n        *\r\n        * @method reMakeDataByGroupCountRange\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByGroupCountRange: function(data, area){\r\n            var range = area.conf.data.groupCountRange,\r\n                begin = range.begin ? range.begin : 0,\r\n                end   = range.end   ? range.end : 0;\r\n                \r\n            var resultItems = [],\r\n                enableYearGroupArr = data.yearGroupArr.slice(begin, end),\r\n                items = data.items,\r\n                item;\r\n                data.yearGroupArr = enableYearGroupArr;\r\n\r\n            for(var i = 0, ilen = items.length; i < ilen; i++){\r\n                item = items[i];\r\n                if(enableYearGroupArr.indexOf(item[area.conf.groupTypes.year]) > -1){\r\n                    resultItems[resultItems.length] = item;\r\n                }\r\n            }\r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n    \r\n        /**\r\n        * 直近の未来と過去のitemを基にしてdataを再作成する\r\n        *\r\n        * @method reMakeDataBySchedule\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataBySchedule: function(data, area){\r\n            var sConf       = area.conf.data.schedule,\r\n                futureCount = sConf.futureCount,\r\n                pastCount   = sConf.pastCount,\r\n                totalView   = sConf.futureCount + sConf.pastCount;\r\n            if((!futureCount && futureCount !== 0) || (!pastCount && pastCount !== 0)){ console.error('reMakeDataBySchedule: 正しく設定が行われていません') };\r\n            \r\n            var resultItems = [],\r\n                items = data.items,\r\n                futureItems = [],\r\n                pastItems = [],\r\n                item;\r\n            \r\n            var currentDate = new Date().getTime(),\r\n                isFuterItem = function(item){\r\n                    return currentDate < Date.parse(item.date);\r\n                };\r\n            \r\n            // 未来と過去のitemをそれぞれ別の配列に入れる\r\n            for(var i = 0, ilen = items.length; i < ilen; i++){\r\n                item = items[i];\r\n                if(isFuterItem(item)){\r\n                    futureItems[futureItems.length] = item;\r\n                }else{\r\n                    pastItems[pastItems.length] = item;\r\n                }\r\n            }\r\n    \r\n            // 「直近」の未来のitemを取得\r\n            if(futureItems.length > 0 && futureCount !== 0){\r\n                resultItems = futureItems.slice(futureCount * -1);\r\n            }\r\n            \r\n            // 「直近」の過去のitemを取得\r\n            if(pastItems.length > 0){\r\n                if(_e.isSet(sConf.ifFutureIsNone) && (futureItems.length === 0 || futureItems.length < sConf.futureCount)){\r\n                    // 未来のitemが無かった時\r\n                    if(futureItems.length === 0){\r\n                        switch(sConf.ifFutureIsNone){\r\n                            case 'SHOW_PAST':\r\n                                resultItems = pastItems.slice(0, sConf.pastCount);\r\n                            break;\r\n                            case 'SHOW_PAST_ADD_FUTURE_COUNT':\r\n                                resultItems = pastItems.slice(0, sConf.pastCount + sConf.futureCount);\r\n                            break;\r\n                            case 'SHOW_NO_DATA_TEXT':\r\n                                resultItems = [];\r\n                            break\r\n                        }\r\n                    }\r\n                    // 未来のitemが不足していた時\r\n                    else if(futureItems.length < sConf.futureCount){\r\n                        switch(sConf.ifFutureIsNone){\r\n                            case 'SHOW_PAST':\r\n                                resultItems = resultItems.concat(pastItems.slice(0, sConf.pastCount));\r\n                            break;\r\n                            // 未来のitemの不足分も過去分で出す\r\n                            case 'SHOW_PAST_ADD_FUTURE_COUNT':\r\n                                resultItems = resultItems.concat(pastItems.slice(0, sConf.pastCount + sConf.futureCount - futureItems.length));\r\n                            break;\r\n                        }\r\n                    }\r\n                }\r\n                else{\r\n                    resultItems = resultItems.concat(pastItems.slice(0, sConf.pastCount));\r\n                }\r\n            }\r\n    \r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n    \r\n        /**\r\n        * グループ毎のアイテムn件\r\n        *\r\n        * @method reMakeDataByItemCountEachGroup\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByItemCountEachGroup: function(data, area){\r\n            var limit = area.conf.data.itemCountEachGroup.limit,\r\n                yearGroupType = area.conf.groupTypes.year,\r\n                counter = {}; // itemの数を数える\r\n                \r\n            var resultItems = [],\r\n                items = data.items,\r\n                item,\r\n                itemYear;\r\n    \r\n            for(var i = 0, ilen = items.length; i < ilen; i++){\r\n                item = items[i];\r\n                itemYear = item[yearGroupType];\r\n    \r\n                // カウンタに年をセットする\r\n                if(!counter[itemYear]){\r\n                    counter[itemYear] = 0;\r\n                }\r\n    \r\n                // グループ毎のitemの数を数える\r\n                if(counter[itemYear] < limit){\r\n                    counter[itemYear]++;\r\n                    resultItems[resultItems.length] = item;\r\n                }\r\n            }\r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n\r\n        /**\r\n        * viewType毎のアイテムn件\r\n        *\r\n        * @method reMakeDataByItemCountEachViewType\r\n        * @param {Object} data\r\n        * @param {Object} area\r\n        * @return {Object} data\r\n        */\r\n        reMakeDataByItemCountEachViewType: function(data, area){\r\n            var limit = area.conf.data.itemCountEachViewType.limit,\r\n                viewType = area.conf.data.viewType; // itemの数を数える\r\n                \r\n            var resultItems = [],\r\n                items = data.items;\r\n\r\n            viewType.forEach(function(viewType){\r\n                let counter = 0;\r\n                for(let i in items){\r\n                    let arrViewType = [];\r\n                    arrViewType.push(viewType);\r\n                    if(_e.isExpectNewsTypeItem(items[i], arrViewType, area.conf.idTypes)){\r\n                        resultItems.push(items[i]);\r\n                        counter++;\r\n                    }\r\n                    if(counter >= limit){\r\n                        break;\r\n                    }\r\n                }\r\n            });\r\n\r\n            _e.sortItems(resultItems, area.conf);\r\n            data.items = resultItems;\r\n            return data;\r\n        },\r\n    \r\n        /**\r\n        * 分割資料のitemに親のプロパティを付与する\r\n        *\r\n        * @method addParentPropToAttachmentItem\r\n        * @param {Object} area\r\n        */\r\n        addParentPropToAttachmentItem: function(item){\r\n            var attachment_item,\r\n                $item;\r\n            if(Number(item.attachment_count) > 0){\r\n                for (var a = 0; a < item.attachment_count; a++) {\r\n                    attachment_item = item.attachment[a];\r\n                    attachment_item.is_attachment_item = true;\r\n\r\n                    if(a === 0){\r\n                        attachment_item.is_attachment_first_item = true;\r\n                    }\r\n                    attachment_item.title = _e.decodeText(attachment_item.title);\r\n                    attachment_item.guid = '';\r\n                    attachment_item.date = item.date;\r\n                    attachment_item.format_date = item.format_date;\r\n                    attachment_item.display_date = item.display_date;\r\n                    attachment_item.comment = '';\r\n                    attachment_item.text = '';\r\n                    attachment_item.news_type = item.news_type;\r\n                    attachment_item.sub_type = item.sub_type;\r\n                    attachment_item.group_name = item.group_name;\r\n                    attachment_item.fiscal_ym = item.fiscal_ym;\r\n                    attachment_item.quarter = item.quarter;\r\n                    attachment_item.tray_code = '';\r\n                    attachment_item.parent_tray_code = '';\r\n                    attachment_item.thumbnail_link = '';\r\n                    attachment_item.page_num = '';\r\n                    attachment_item.doc_cat = '';\r\n                    attachment_item.contents_order = item.contents_order;\r\n                    attachment_