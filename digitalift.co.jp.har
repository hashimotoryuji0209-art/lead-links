tomYearType(){}\r\n\r\n    CustomYearType.prototype.list = [];\r\n    \r\n    CustomYearType.prototype.set = function(name, callback){\r\n        if(_e.typeOf(name) === 'array'){\r\n            var types = name;\r\n            var type;\r\n            for(var i = 0, len = types.length; i < len; i++){\r\n                type = types[i];\r\n                this.list.push({\r\n                    name: type.name,\r\n                    callback: type.callback\r\n                });                        \r\n            }    \r\n        }else{\r\n            this.list.push({\r\n                name: name,\r\n                callback: callback\r\n            });             \r\n        }\r\n    }\r\n    CustomYearType.prototype.do = function(item){\r\n        var def;\r\n        for(var i = 0, len = this.list.length; i < len; i++){\r\n            def = this.list[i];\r\n            item[def.name] = def.callback.apply(item);\r\n        }\r\n    }\r\n    _e.customYearType = new CustomYearType();\r\n    \r\n    /**\r\n    * 特定のセレクタを持つHTML要素に対してhrefや子要素を挿入する\r\n    *\r\n    * @class StringShooter\r\n    * @constructor\r\n    */\r\n    function StringShooter(){\r\n        var self = this;\r\n        this.list = [];\r\n\r\n        this.set = function(param){\r\n            if(_e.typeOf(param) === 'array'){\r\n                for(var i = 0, len = param.length; i < len; i++){\r\n                    this.list[this.list.length] = param[i];\r\n                }\r\n            }else{\r\n                this.list[this.list.length] = param;\r\n            }\r\n        }\r\n\r\n        /**\r\n        * listの全てのセレクタに対してcallbackを実行する\r\n        *\r\n        * @method shoot\r\n        * @param {String} foo Argument 1　(メソッド内で使用するパラメータの概要を記述します。)\r\n        */\r\n        this.shoot = function(){\r\n            $(function(){\r\n                var $target\r\n                , strings = _e.getStrings();\r\n                $.each(self.list, function(idx){\r\n                    $target = $(this.selecter);\r\n                    if($target.get(0)){\r\n                        this.callback($target, strings);\r\n                    }\r\n                });\r\n            });\r\n        };\r\n    }\r\n    _e.stringShooter = new StringShooter();\r\n\r\n    }(EIR, eirjQuery));"
