 \r\n    /**\r\n    * UIから年や、ニュースタイプを制御できるUIを作成する\r\n    * HTML作成メソッドは定義していないので、年制御とニュースタイプ制御で別々に実装する必要有り\r\n    *\r\n    * @class Controller（抽象クラス）\r\n    * @constructor\r\n    */\r\n    function Controller(){}\r\n\r\n    /**\r\n    * 選択されているHTML要素に付与されるクラス名\r\n    *\r\n    * @property activeClass\r\n    * @type {String}\r\n    */\r\n    Controller.prototype.activeClass  = 'active';\r\n\r\n    /**\r\n    * activeClassを付ける要素を示すクラス名\r\n    *\r\n    * @property activeTargetClass\r\n    * @type {String}\r\n    */\r\n    Controller.prototype.activeTargetClass = 'activeTarget';\r\n\r\n    /**\r\n    * データ属性の名前\r\n    *\r\n    * @property dataAttr\r\n    * @type {String}\r\n    */\r\n    Controller.prototype.dataAttr = 'eir-ctrl';\r\n\r\n    /**\r\n    * コントローラのHTML要素を作成、且つイベントリスナーをつける\r\n    *\r\n    * @method generate (メソッド名の記述)\r\n    */\r\n    Controller.prototype.generate = function(){};\r\n    \r\n    \r\n    /**\r\n    * groupの型に合わせて見出しを作り出す\r\n    * 年やニュースタイプを示すグループの型は多彩で、Object, Array, String, Numberなどを許容できます\r\n    * 型を判定した上で、それぞれの値を確認し、その値から見出しを作成します\r\n    *\r\n    * @method makeMidashi (メソッド名の記述)\r\n    * @param {Object, Array, String, Number} 年やニュースタイプのグループを示すオブジェクトや値\r\n    * @param {Object} index 何番目の要素かを示す数値\r\n    * @return {String} グループの値から作成されたテキスト\r\n    */\r\n    Controller.prototype.makeMidashi = function(group, index){\r\n        var area = this.area,\r\n            groupType = this.groupType,\r\n            groupArr = this.groupArr,\r\n            formatGroupText = this.groupTypeMethods.formatGroupText,\r\n            customMethods,\r\n            nameText = '';\r\n    \r\n        // 表示する見出しの作成\r\n        _e.formatGroupText.init(groupType, group, _e.context.MAKE_CTRL_MIDASHI, area);\r\n        switch(_e.typeOf(group)){\r\n            case 'object':\r\n                if(group.isCustom){\r\n                    _e.formatGroupText.init(group.name, group, _e.context.MAKE_CTRL_MIDASHI, area);\r\n                    nameText = group.formatGroupText.apply(_e.formatGroupText);\r\n                }\r\n                else if(_e.typeOf(group.name) === 'function'){\r\n                    nameText = group.name.apply(group, [groupArr, index]);\r\n                }\r\n                else{\r\n                    nameText = group.name;\r\n                }\r\n            break;\r\n    \r\n            case 'array':\r\n                nameText = _e.formatGroupText.intervalGroup();\r\n            break;\r\n    \r\n            default:\r\n                customMethods = _e.serchObjectInnerArr(this.groupTypeMethods.custom, 'name', group);\r\n                if(_e.isSet(customMethods)){\r\n                    nameText = customMethods[0].formatGroupText.apply(_e.formatGroupText);\t\r\n                }\r\n                else{\r\n                    nameText = formatGroupText.apply(_e.formatGroupText);\r\n                }\r\n            break;\r\n        }\r\n        return nameText;\r\n    }\r\n    \r\n    /**\r\n    * itemのフィルタを実行し、areaのdataにセットする\r\n    *\r\n    * @method doFilter\r\n    * @param {Object} area areaオブジェクト\r\n    */\r\n    Controller.prototype.doFilter = function(area){\r\n        var group       = this.currentValue,\r\n            groupArr    = this.groupArr,\r\n            groupType   = this.groupType,\r\n            filtedItems = area.data.filtedItems;\r\n    \r\n        switch(_e.typeOf(group)){\r\n            case 'object':\r\n                if(group.isCustom){\r\n                    filtedItems = group.makeFilteredItems.apply(this, [group, groupArr, groupType, filtedItems, area]);\r\n                }\r\n                else if(group.callback){\r\n                    filtedItems = group.callback.apply(this, [group, groupArr, groupType, filtedItems, area]);\r\n                }\r\n                else{\r\n                    filtedItems = this.makeFilteredItems.apply(this, [group, groupArr, groupType, filtedItems, area]);\r\n                }\r\n            break;\r\n    \r\n            case 'array':\r\n 