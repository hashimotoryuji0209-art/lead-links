          "content": {
            "size": 53210,
            "mimeType": "application/javascript",
            "compression": 38776,
            "text": "/**\r\n* EIR Javascript v1.4.0\r\n* DATE: 2021-06-10\r\n*/\r\n\r\n(function(_e, $){\r\n\r\n    var drawHtml = {\r\n    \r\n        /**\r\n        * areaが持つitem全ての中から、HTMLに実際に表示するitemを抽出する\r\n        *\r\n        * @method makeDataForDisplay\r\n        * @param {Object} area\r\n        */\r\n        makeDataForDisplay: function(area){\r\n            var conf = area.conf,\r\n                controllers = area.controllers,\r\n                items = area.data.items,\r\n                filtedItems = items;\r\n                area.data.filtedItems = [].concat(area.data.items);\r\n    \r\n            if(_e.isSet(controllers.newsType)){\r\n                controllers.newsType.doFilter(area);\r\n            }\r\n            if(_e.isSet(controllers.year)){\r\n                controllers.year.doFilter(area);\r\n            }\r\n\r\n            // ニュースタイプコントローラと表示数制御を同時に実行する\r\n            if(conf.data.itemCountRange.enable && conf.controller.newsType.enable){\r\n                area.data.filtedItems = area.data.filtedItems.slice(\r\n                     conf.data.itemCountRange.begin,\r\n                     conf.data.itemCountRange.end\r\n                );\r\n            }\r\n\r\n            //同一日付が並んだ場合非表示とする。\r\n            if(conf.data.hiddenSameDay){\r\n                let beforeDate = '';\r\n                area.data.filtedItems = area.data.filtedItems.map(function(item){\r\n                    if(beforeDate == item.date){\r\n                        item.is_sameDay_item = true;\r\n                    }\r\n                    beforeDate = item.date;\r\n                    return item;\r\n                });\r\n            }\r\n        },\r\n\r\n        /**\r\n        * areaのHTML要素に対してデータやRSSや注記などのHTML要素を追加しする\r\n        *\r\n        * @method drawHtmlToArea\r\n        * @param {Object} area\r\n        */\r\n        drawHtmlToArea: function(area){\r\n            var $areaRoot = area.$rootElement,\r\n                $yearRoot = $('.eir_controller_year'),\r\n                $yearRootArea = $('.eir_controller_year_' + area.areaName),\r\n                $newstypeRoot = $('.eir_controller_newstype'),\r\n                $newstypeRootArea = $('.eir_controller_newstype_' + area.areaName),\r\n                $yearRootBottom = $('.eir_controller_year_bottom'),\r\n                $yearRootAreaBottom = $('.eir_controller_year_bottom_' + area.areaName),\r\n                $newstypeRootBottom = $('.eir_controller_newstype_bottom'),\r\n                $newstypeRootAreaBottom = $('.eir_controller_newstype_bottom_' + area.areaName),\r\n                strings = _e.getStrings(),\r\n                conf = area.conf,\r\n                controllers = area.controllers;\r\n    \r\n            // RSS\r\n            if(conf.rss.enable){\r\n                var rssText = strings.getRssText(conf.rss.partsNumber);\r\n                $areaRoot.append(rssText);\r\n            }\r\n            if(conf.rss.partsNumber == '★★RSS_PARTS_NUMBER★★'){\r\n                $('.eir_rss a').attr('href', eirPassApp + 'xml/' + _e.testRssXml);\r\n            }\r\n    \r\n            // 年制御のコントローラ\r\n            if(_e.isSet(controllers.year)){\r\n                if(area.conf.controller.year.enable && area.conf.controller.year.viewFlg === true\r\n                    && area.conf.controller.year.displayPosition !== 'bottom'){\r\n                    if(controllers.year.groupArr.length > 0){\r\n                        if($yearRootArea.length){\r\n                            controllers.year.appendElmTo($yearRootArea);\r\n                        }\r\n                        else if($yearRoot.length){\r\n                            controllers.year.appendElmTo($yearRoot);\r\n                        }\r\n                        else{\r\n                            controllers.year.appendElmTo($areaRoot);\r\n                        }                        \r\n                    }\r\n                }\r\n            }\r\n    \r\n            // ニュースタイプのコントローラ\r\n            if(_e.isSet(controllers.newsType)){\r\n                if(area.conf.controller.newsType.enable && area.conf.controller.newsType.viewFlg === true\r\n                    && area.conf.controller.newsType.displayPosition !== 'bottom'){\r\n                    if(controllers.newsType.groupArr.length > 0){\r\n                        if($newstypeRootArea.length){\r\n                            controllers.newsType.appendElmTo($newstypeRootArea);\r\n                        }\r\n                        else if($newstypeRoot.length){\r\n                            controllers.newsType.appendElmTo($newstypeRoot);\r\n                        }\r\n                        else{\r\n                            controllers.newsType.appendElmTo($areaRoot);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n    \r\n            // カレンダー画像\r\n            if(conf.calendarImage){\r\n                var calImgText = strings.getCalendarImageText();\r\n                $areaRoot.append(calImgText);\r\n            }\r\n    \r\n            // 書類のリストを書き出すエリアを生成\r\n            $areaRoot.append(area.$dataRootElement);\r\n            _e.drawHtmlToDataArea(area);\r\n\r\n            // 年制御のコントローラ(画面下部表示)\r\n            if(_e.isSet(controllers.year)){\r\n                if(area.conf.controller.year.enable && area.conf.controller.year.viewFlg === true\r\n                    && area.conf.controller.year.displayPosition !== 'top'){\r\n                    if(controllers.year.groupArr.length > 0){\r\n                        if($yearRootAreaBottom.length){\r\n                            controllers.year.appendElmTo($yearRootAreaBottom);\r\n                        }\r\n                        else if($yearRootBottom.length){\r\n                            controllers.year.appendElmTo($yearRootBottom);\r\n                        }\r\n                        else{\r\n                            controllers.year.appendElmTo($areaRoot);\r\n                        }                        \r\n                    }\r\n                }\r\n            }\r\n\r\n            // ニュースタイプのコントローラ(画面下部表示)\r\n            if(_e.isSet(controllers.newsType)){\r\n                if(area.conf.controller.newsType.enable && area.conf.controller.newsType.viewFlg === true\r\n                    && area.conf.controller.newsType.displayPosition !== 'top'){\r\n                    if(controllers.newsType.groupArr.length > 0){\r\n                        if($newstypeRootAreaBottom.length){\r\n                            controllers.newsType.appendElmTo($newstypeRootAreaBottom);\r\n                        }\r\n                        else if($newstypeRootBottom.length){\r\n                            controllers.newsType.appendElmTo($newstypeRootBottom);\r\n                        }\r\n                        else{\r\n                            controllers.newsType.appendElmTo($areaRoot);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n    \r\n            // もっと見るボタン、アンカーリンク等、表示されたHTMLに依存するもの\r\n            if(_e.isSet(conf.data.reDrawHtml)){\r\n                _e.reDrawHtmlToArea(area);\r\n            }\r\n    \r\n            // 有報CSV\r\n            if(conf.yuhoCsv.enable){\r\n                var yuhoCsvText = strings.getYuhoCsvText(conf.yuhoCsv.partsNumber);\r\n                $areaRoot.append(yuhoCsvText);\r\n            }\r\n\r\n            // カレンダー注記\r\n            if(area.conf.calendarNote){\r\n                $areaRoot.append(_e.getStrings().getCalendarNoteText());\r\n            }\r\n\r\n            // Adobe注記\r\n            if(conf.pdfNote.enable){\r\n                var pdfNote = strings.getPdfNoteText();\r\n                $areaRoot.append(pdfNote);\r\n            }\r\n\r\n            // 有報注記\r\n            if(conf.yuhoNote && conf.yuhoNote.enable){\r\n                var yuhoNote = strings.getYuhoNoteText();\r\n                $areaRoot.append(yuhoNote);\r\n            }\r\n    \r\n            // PNEX注記\r\n            if(conf.pnexNote.enable){\r\n                var pnexNote = strings.getPnexNoteText();\r\n                $areaRoot.append(pnexNote);\r\n            }\r\n        },\r\n        \r\n        /**\r\n        * 資料リストエリアにおいて、データのリストを描画する\r\n        *\r\n        * @method drawHtmlToDataArea\r\n        * @param {Object} area\r\n        */\r\n        drawHtmlToDataArea: function(area){\r\n            area.$dataRootElement.empty();\r\n\r\n            if(area.data.filtedItems.length > 0){\r\n                var filtedItems = area.data.filtedItems, // 表示するitem\r\n                    item,\r\n                    htmlTemp = _e.htmlTemplate.list[area.conf.htmlTemplate],\r\n                    preHtmlTemp,\r\n                    splittedHtmlTemp = _e.makeSplittedTpl(htmlTemp, area),\r\n                    itemDrawMethod = _e.choiceItemDrawMethod(htmlTemp),\r\n                    memo = { year: [], quarter: [], newsType: [], isYearChange: false, isQuarterChange: false, isNewsTypeChange: false, $container: $('<div></div>'), isFirst: true},\r\n                    $container = memo.$container;\r\n            \r\n                // itemをループし、HTMLを作成する\r\n                for(var i = 0, len = filtedItems.length; i < len; i++){\r\n                    item = filtedItems[i];\r\n\r\n                    if(area.conf.groupTypes.fyByTitle.enable && item.fiscal_ym == \"\")\r\n                        continue;\r\n\r\n                    if(itemDrawMethod.name == \"matrix_quarter\"){\r\n                        if(!(item.quarter==='10'||item.quarter==='20'||item.quarter==='30'||item.quarter==='100')){\r\n                            continue;\r\n                        }\r\n                    }\r\n                    \r\n                    // 描画済み、またはこれから描画する年や四半期の情報を記録する\r\n                    _e.upDateMemo(item, memo, area);\r\n                    \r\n                    // item単位でHTMLテンプレート切り替え\r\n                    preHtmlTemp = htmlTemp;\r\n                    htmlTemp = _e.htmlTempSwitcher(htmlTemp, memo, area);\r\n                    if(preHtmlTemp !== htmlTemp){\r\n                        splittedHtmlTemp = _e.makeSplittedTpl(htmlTemp, area);\r\n                        itemDrawMethod = _e.choiceItemDrawMethod(htmlTemp);\r\n                    }\r\n\r\n                    // HTML作成\r\n                    $container.append(itemDrawMethod(item, splittedHtmlTemp, memo, area.conf.groupTypes.year, area.groupTypeMethods.year.formatGroupText, area));\r\n                }\r\n                // EIRのループタグを削除する\r\n                $container.find(_e.allowTplExpr.join(', ')).children().unwrap();\r\n\r\n                // 画面に描画する\r\n                area.$dataRootElement.append($container.children());\r\n\r\n                // loop-itemにアイテムが出力されなかった時、指定したクラスをremoveする\r\n                $('.remove-area-if-has-loop-tag').each(function(index,rArea){\r\n                    if($(rArea).find('.loop-item').length || $(rArea).find('loop-item').length){\r\n                        rArea.remove();\r\n                    }\r\n                })\r\n                $('.remove-area-if-has-loop-tag').removeClass('remove-area-if-has-loop-tag');\r\n\r\n                // 見出し表示非表示制御\r\n                if(!area.conf.data.headFlg || !splittedHtmlTemp.year){\r\n                    area.$dataRootElement.find('.eirHeading').remove();        \r\n                }\r\n                if(!splittedHtmlTemp.quarter){\r\n                    area.$dataRootElement.find('.eirQuarter').remove();        \r\n                }\r\n\r\n                if(area.conf.data.reDrawHtml.pager.enable){\r\n                    _e.makePager(area);\r\n                }\r\n            }\r\n            else{\r\n                // 表示するデータが無かったとき\r\n                if(area.conf.data.schedule.enable){\r\n                    area.$dataRootElement.append(_e.getStrings().noScheduleText);\r\n                }else{\r\n                    area.$dataRootElement.append(_e.getStrings().noDataText);        \r\n                }\r\n            }\r\n        },\r\n\r\n        /**\r\n        * drawHtmlToDataAreaにおいて、描画中または描画済みのitemの情報を記録する変数を更新する\r\n        *\r\n        * @method upDateMemo\r\n        * @param {Object} item\r\n        * @param {Object} memo\r\n        * @param {Object} area\r\n        */\r\n        upDateMemo: function(item, memo, area){\r\n            // 年更新\r\n            if(_e.uniquePush(memo.year, item[area.conf.groupTypes.year])){\r\n                memo.isYearChange = true;\r\n                memo.quarter.length = 0; // 年が新しくなると、四半期の情報をクリアする\r\n            }else{\r\n                memo.isYearChange = false;\r\n            }\r\n\r\n            // 四半期更新\r\n            if(_e.uniquePush(memo.quarter, item.quarter)){\r\n                memo.isQuarterChange = true;\r\n                memo.newsType.length = 0; // 四半期が新しくなると、ニュースタイプの情報をクリアする\r\n            }else{\r\n                memo.isQuarterChange = false;\r\n            }\r\n\r\n            // ニュースタイプ更新\r\n            switch(item.news_type){\r\n                case 'ir_material':\r\n                case 'ir_material_for_fiscal_ym':\r\n                case 'announcement':\r\n                case 'calendar':\r\n                    type = item.sub_type;\r\n                    break;\r\n                default:\r\n                    if(area.conf.data.viewType.indexOf(item.sub_type) > -1){\r\n                        type = item.sub_type;\r\n                    }else{\r\n                        type = item.news_type;\r\n                    }\r\n                    break;\r\n            }\r\n            if(_e.uniquePush(memo.newsType, type)){\r\n                memo.isNewsTypeChange = true;\r\n            }else{\r\n                memo.isNewsTypeChange = false;\r\n            }\r\n        },\r\n\r\n        /**\r\n        * EIRはHTMLテンプレートのループ階層パターン毎に描画メソッドを切り替える\r\n        * このメソッドはその機能のメインメソッド\r\n        *\r\n        * @method choiceItemDrawMethod\r\n        * @param {String} htmlTpl\r\n        * @retur