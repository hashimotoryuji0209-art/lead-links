            "text": "/**\r\n* EIR Javascript v1.4.0\r\n* DATE: 2021-06-10\r\n*/\r\n\r\n(function(_e, $){\r\n\r\n    // データエリアのラッパ\r\n    _e.htmlTemplate.dataArea = '<div class=\"eirDataArea s_eirBlock\"></div>';\r\n    \r\n    // 株主総会、個人投資家向け説明会等の表\r\n    _e.htmlTemplate.eirTextTable = {\r\n        midashiRow: _e.hereDoc(function(){\r\n          /*\r\n            <tr class=\"eirTable_rowHeading\">\r\n              <th class=\"needAttrColSpan\"><h4>%title%</h4></th>\r\n            </tr>\r\n          */\r\n        }),\r\n\r\n        rowThumb: _e.hereDoc(function(){\r\n          /*\r\n            <tr class=\"eirTable_rowThumb\">\r\n              <td class=\"needAttrColSpan\">\r\n                <img class=\"thumbImg\" >\r\n              </td>\r\n            </tr>\r\n          */\r\n        }),\r\n\r\n        colThumb: _e.hereDoc(function(){\r\n          /*\r\n            <td class=\"eirTable_colThumb needAttrRowSpan\">\r\n              <img class=\"thumbImg\">\r\n            </td>\r\n          */\r\n        }),\r\n\r\n        relationalItemRow: _e.hereDoc(function(){\r\n          /*\r\n            <tr class=\"eirTable_rowRelationalMaterial\">\r\n              <td>関連資料</td>\r\n              <td>\r\n                <loop-item></loop-item>\r\n              </td>\r\n            </tr>\r\n          */\r\n        }),\r\n    };\r\n\r\n    // アンカーリンク\r\n    _e.htmlTemplate.anchorLink = {\r\n        default:{\r\n            root: '<div class=\"eirAnchorLink\"><ul class=\"valueParent s_eirAnchor\"></ul></div>',\r\n            value: '<li><a href=\"%linkTarget%\">%formatGroupText%</a></li>'\r\n        },\r\n        button: {\r\n            root: '<div class=\"eirAnchorLink\"><ul class=\"valueParent s_eirAnchor\"></ul></div>',\r\n            value: _e.hereDoc(function() {/*\r\n                <li><a href=\"%linkTarget%\" class=\"col\">%formatGroupText%</a></li>\r\n            */})\r\n        },\r\n        button2: {\r\n            root: '<div class=\"link-anchor-01\"><ul class=\"valueParent s_eirAnchor\"></ul></div>',\r\n            value: _e.hereDoc(function() {/*\r\n                <li><a href=\"%linkTarget%\" class=\"col\">%formatGroupText%</a></li>\r\n            */})\r\n        }\r\n    };\r\n\r\n\r\n    // タグ構造テンプレート内で許されているHTMLタグ一覧\r\n    _e.allowTplTags = ['loop-year', 'loop-quarter', 'loop-news-type', 'loop-item', 'loop-text', 'eir-text-area', 'eir-text-table', 'eir-bridge-text', 'eir-matrix', 'eir-attachment', 'eir-teisei'];\r\n    _e.allowTplExpr = ['loop-year', '.loop-year', 'loop-quarter', '.loop-quarter', 'loop-news-type', '.loop-news-type', 'loop-item', '.loop-item', 'loop-text', '.loop-text', '.eir-text-area', '.eir-text-table', 'eir-bridge-text', 'eir-matrix', 'eir-attachment', '.eir-attachment', 'eir-teisei', '.eir-teisei'];\r\n    _e.arrowTplExprReg = /eir-bridge-text|eir-text-table|eir-text-area|loop-year|loop-quarter|loop-news-type|loop-item|loop-text|eir-attachment|eir-teisei/;\r\n    \r\n    _e.context = {\r\n        MAKE_CTRL_MIDASHI: 'makeCtrlHead',\r\n        MAKE_YEAR_MIDASHI: 'makeYearHead',\r\n    };\r\n\r\n    // HTMLテンプレート切り替え\r\n    // itemのループ毎に切り替え確認\r\n    _e.htmlTempSwitcher = function(currentTemp, memo, area){\r\n        //switch(area.areaName){\r\n        //    case 'eirSampleArea':\r\n        //        if(memo.year.length > 2){\r\n        //            return _e.htmlTemplate.list.level2;\r\n        //        }\r\n        //    break;\r\n        //}\r\n        return currentTemp;\r\n    };\r\n\r\n    // ニュースタイプ名定義\r\n    _e.newsTypeNameNames = [\r\n        {\r\n            id: 'tanshin',\r\n            name: '決算短信'\r\n        },\r\n        {\r\n            id: 'yuho',\r\n            name: '有報'\r\n        },\r\n        {\r\n            id: 'ir_material_for_fiscal_ym',\r\n            name: '年度IR資料00'\r\n        },\r\n        {\r\n            id: 'ir_material_for_fiscal_ym1',\r\n            name: '年度IR資料01'\r\n        },\r\n        {\r\n            id: 'ir_material',\r\n            name: 'IR資料00'\r\n        },\r\n        {\r\n            id: 'ir_material1',\r\n            name: 'IR資料01'\r\n        }\r\n    ];\r\n\r\n    // guidで指定されたitemのテキストを表示する\r\n    _e.GuidText.prototype.main = function(area, data){\r\n        // guid取得\r\n        var query = _e.parseUrlQuery(),\r\n            guid = '';\r\n        if(query.guid){\r\n            guid = query.guid;\r\n        }\r\n\r\n        // item取得\r\n        var items = data.item,\r\n            item,\r\n            targetItem;\r\n        for(var i = 0, len = items.length; i < len; i++){\r\n            item = items[i];\r\n            if(item.guid === guid){\r\n                targetItem = item;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if(!targetItem && _e.env.debug){\r\n            throw new Error('指定のguidのitemが見つかりませんでした');\r\n        }\r\n        // アンエスケープ\r\n        targetItem.text = _e.decodeText(targetItem.text);\r\n\r\n        var tpl = _e.makeSplittedTpl(this.htmlTemplate, area);\r\n        var contents = tpl.highestLevel.replace(/%heading%/, targetItem.title)\r\n                                       .replace(/%format_date%/, targetItem.format_date)\r\n                                       .replace(/%text%/, targetItem.text);\r\n        var $contents = $(contents);\r\n\r\n        // サムネイル\r\n        if(area.conf.data.thumbFlg == false || targetItem.thumbnail_link == ''){\r\n            $contents.find('.eirItem_thumb').remove();\r\n        }\r\n        else{\r\n            $contents.find('.eirItem_thumb_image').attr('src', targetItem.thumbnail_link);\r\n        }\r\n\r\n        this.$tmp = $('<div></div>');\r\n        if(targetItem.link.length > 0){\r\n            this.drawItem(targetItem, tpl.item, area);    \r\n        }\r\n        _e.appendTpl($contents, this.$tmp, 'loop-item');\r\n        area.$rootElement.append($contents);\r\n    }\r\n\r\n    _e.GuidText.prototype.drawItem = function(item, itemTpl, area){\r\n        // 書類のHTMLを作成\r\n        $item = _e.makeItemHtml(item, itemTpl, false/* teiseiFlg */, area);\r\n        this.$tmp.append($item);\r\n\r\n        // 追加書類\r\n        if(area.conf.data.attachment.enable){\r\n            for (var a = 0; a < item.attachment_count; a++) {\r\n                var attachment_item = item.attachment[a];\r\n                $item = _e.makeItemHtml(attachment_item, itemTpl, true/* teiseiFlg */, area);\r\n                this.$tmp.append($item);\r\n            }\r\n        }\r\n    }\r\n\r\n    // GUIDテキストのHTMLテンプレート\r\n    _e.GuidText.prototype.htmlTemplate = _e.hereDoc(function(){\r\n        /*\r\n            <div class=\"eirGuidContainer eirUseText eirUseText_guidText\">\r\n                <h2 class=\"eirHeading hdg-l2-01\"><span class=\"hdg\">%heading%</span></h2>\r\n                <div class=\"guidDate\">%format_date%</div>\r\n                <figure class=\"eirItem_thumb image\"><img class=\"eirItem_thumb_image\"></figure>\r\n                <div>%text%</div>\r\n                <div class=\"eirGroup\">\r\n                    <loop-item>\r\n                        <dl class=\"eirItem\">\r\n                            <dt class=\"eirItem_head\">\r\n                                <time class=\"eirItem_date\">%format_date%</time>\r\n                                <div class=\"eirItem_category news_label %category_class%\">%category_icon%</div>\r\n                            </dt>\r\n                            <dd class=\"eirItem_body\">\r\n                                <span class=\"eirItem_rule\">┗ </span>\r\n                                <a href=\"%link%\" target=\"%target%\" class=\"eirItem_title eirItem_title_link\">\r\n                                    <span class=\"ttlSpan text\">%title%</span>\r\n                                </a>\r\n                                <span class=\"eirItem_title eirItem_title_text\">%title%</span>\r\n                                <span class=\"eirItem_type eirItem_type-%type%\">%type_upper%</span>\r\n                                <!-- <span class=\"eirItem_ty