            "compression": 99365,
            "text": "/**\r\n* EIR Javascript v1.4.0\r\n* DATE: 2021-06-10\r\n*/\r\n\r\n/**\r\n* EIR用のグローバル変数\r\n*\r\n* @type {Object}\r\n*/\r\nvar EIR = _e = {};\r\n\r\n/**\r\n* EIRのバージョン\r\n*\r\n* @property version\r\n* @type {Object}\r\n*/\r\n_e.version = '1.4.0';\r\n\r\n/**\r\n* URLに渡されたクエリを{key:value}形式のオブジェクトで保持する\r\n*\r\n* @property queryMap\r\n* @type {Object}\r\n*/\r\n_e.queryMap = parseUrlQuery();\r\n\r\n\r\n/**\r\n* EIRの環境の設定を保持するオブジェクト\r\n*\r\n* @property env\r\n* @type {Object}\r\n* @default {}\r\n*/\r\n_e.env = {};\r\n\r\n/**\r\n* demo or public\r\n*\r\n* @property level\r\n* @type {Object}\r\n* @default HTMLが配置されたロケーション、URLのクエリなどによって動的に変化\r\n*/\r\n_e.env.level = getEnvLevel();\r\n\r\n/**\r\n* 言語設定\r\n*\r\n* @property language\r\n* @type {String}\r\n* @default eir.jsに定義された変数によって変化\r\n*/\r\n_e.env.language = eirLanguage;\r\nreWriteEirPath();\r\n\r\n/**\r\n* /v5parts/●●●●/jp/yyyymmdd/までのパス\r\n*\r\n* @property eirPass\r\n* @type {Object}\r\n*/\r\n_e.env.eirPass = eirPass;\r\n\r\n/**\r\n* /v5parts/●●●●/jp/yyyymmdd/core/までのパス\r\n*\r\n* @property eirPassCore\r\n* @type {Object}\r\n* @default true\r\n*/\r\n_e.env.eirPassCore = eirPassCore;\r\n\r\n/**\r\n* /v5parts/●●●●/jp/yyyymmdd/app/までのパス\r\n*\r\n* @property eirPassApp\r\n* @type {Object}\r\n* @default true\r\n*/\r\n_e.env.eirPassApp = eirPassApp;\r\n\r\n/**\r\n* EIRのサーバーのドメイン\r\n*\r\n* @property eirUrl\r\n* @type {String}\r\n*/\r\n_e.env.eirUrl = eirUrl;\r\n\r\n/**\r\n* 証券コード\r\n*\r\n* @property eirCode\r\n* @type {String}\r\n*/\r\n_e.env.eirCode = eirCode;\r\n\r\n/**\r\n* setParts(fileName)でしてされたファイル名\r\n*\r\n* @property scriptName\r\n* @type {String}\r\n*/\r\n_e.env.scriptName = '';\r\n\r\n  /**\r\n  * テストJSONを読み込むかどうか\r\n  * 「?eirTest=true」のクエリを渡すと強制的にtrueとなります\r\n  *\r\n  * @property testMode\r\n  * @type {Boolean}\r\n  * @default true\r\n  */\r\n _e.env.testMode = false;\r\n  \r\n /**\r\n * デバッグモードにするかどうか\r\n * デバッグモードにすると、キャッシュを不可にする機能がなくなり、ブレークポイントの設定が可能になります\r\n *\r\n * @property debug\r\n * @type {Boolean}\r\n * @default true\r\n */\r\n _e.env.debug = false;\r\n\r\n// JSONPのコール縛関数を定義する\r\nfunction createJsonCallback() {\r\n        \r\n    var BASE_TEXT = 'eolparts_';\r\n    var jsonReg = /(announcement_[0-9]*?)\\.js/;\r\n    var nrJsonReg = /(new_release_[0-9]*?)\\.js/;\r\n    var jsonCallBackMatch = _e.json.match(jsonReg);\r\n    var nrJsonCallBackMatch = _e.nrJson.match(nrJsonReg);\r\n    var jsonCallBackName = jsonCallBackMatch ? BASE_TEXT + jsonCallBackMatch[1] : null ;\r\n    var nrJsonCallBackName = nrJsonCallBackMatch ? BASE_TEXT + nrJsonCallBackMatch[1] : null ;\r\n    if (jsonCallBackName) {\r\n        window[jsonCallBackName] = function(data) {\r\n            _e.data = data;\r\n            window['eolparts_announcement_extend'] = function(dataExtend) {\r\n                _e.dataExtend = dataExtend;\r\n            _e.eirMain();\r\n            }\r\n        };\r\n    }\r\n    if (nrJsonCallBackName) {\r\n        window[nrJsonCallBackName] = function(nrData) {\r\n            _e.nrData = nrData;\r\n        };\r\n    }\r\n    window.eolparts_announcement_test = function(testData) {\r\n        _e.data = testData;\r\n        _e.eirMain();\r\n    };\r\n}\r\n\r\n// URLのクエリを解析してkey: valueのオブジェクトを作成する\r\nfunction parseUrlQuery(search) {\r\n    search = search || window.location.search;\r\n    var queryMap = {}\r\n      , queries = search.substr(1).split('&')\r\n      , split;\r\n\r\n    if (!search) {\r\n        return queryMap;\r\n    }\r\n    for(var q = 0, qLen = queries.length; q < qLen; q++){\r\n        split = queries[q].split('=');\r\n        queryMap[split[0]] = split[1];        \r\n    }\r\n    return queryMap;\r\n}\r\n\r\n// demo or publicを判定する\r\n// 優先順位: location < URLクエリ\r\nfunction getEnvLevel() {\r\n    var level = '';\r\n    var demoLocation = /customer[0-9]*\\.pronexus|eol\\-test\\.com|aspdev|localhost/;\r\n    // ロケーションで判定\r\n    if (location.protocol == 'file:' || demoLocation.test(location.hostname)) {\r\n        level = 'demo';\r\n    } else {\r\n        level = 'public';\r\n    }\r\n    // クエリで渡された時\r\n    if (_e.queryMap.level) {\r\n        level = _e.queryMap.level;\r\n    } else {\r\n        // #で渡された時\r\n        switch (location.hash) {\r\n        case '#demo':\r\n        case '#public':\r\n            level = _e.queryMap.level = location.hash.substr(1);\r\n            break;\r\n        }\r\n    }\r\n    return level;\r\n}\r\n// debug, test\r\nfunction setEnvMode() {\r\n    \r\n    // ページ一括指定\r\n    // console.log(_e.env.scriptName, _e.env.testModeOverRidePages);\r\n    if(_e.env.testModeOverRidePages && _e.env.testModeOverRidePages.indexOf(_e.env.scriptName) > -1){\r\n        _e.env.testMode = true;\r\n    }\r\n\r\n    // publicの際は強制的にテスト、デバッグモードを無効\r\n    if (getEnvLevel() === 'public'){\r\n        _e.env.debug = false;\r\n        _e.env.testMode = false;\r\n    }\r\n\r\n    // クエリ判定\r\n    if (_e.queryMap.debug == 'true') {\r\n        _e.env.debug = true;\r\n    }\r\n    if (_e.queryMap.eirTest == 'true') {\r\n        _e.env.testMode = true;\r\n    }\r\n}\r\n\r\n// eirPassを環境に合わせて書き換える\r\nfunction reWriteEirPath() {\r\n    var currentLocation = String(window.location);\r\n    // demo or public\r\n    switch (_e.env.level) {\r\n        case 'demo':\r\n            eirPass = eirPass.replace(/public/, 'demo');\r\n            eirPassCore = eirPassCore.replace(/public/, 'demo');\r\n            eirPassApp = eirPassApp.replace(/public/, 'demo');\r\n            break;\r\n        case 'public':\r\n            break;\r\n        default:\r\n            if (demoLocation.test(currentLocation)) {\r\n                eirPass = eirPass.replace(/public/, 'demo');\r\n                eirPassCore = eirPassCore.replace(/public/, 'demo');\r\n                eirPassApp = eirPassApp.replace(/public/, 'demo');\r\n            }\r\n            break;\r\n    }\r\n}\r\n\r\n// jsファイル等をロードする時のキャッシュ対策のクエリを作成する\r\nfunction getCashQuery() {\r\n    var gt = '?gt=' + new Date().getTime();\r\n    // キャッシュ制御\r\n    if (document.location.protocol != 'https:' && document.location.protocol != 'http:') {\r\n        gt = '';\r\n    }\r\n    if (_e.env.debug || _e.env.testMode) {\r\n        gt = '';\r\n    }\r\n    return gt;\r\n}\r\n\r\nfunction runEir() {\r\n    var gt = getCashQuery();\r\n    \r\n    // 読みこむJSONPを定義\r\n    // SSL対応\r\n    if (_e.isHttpsLocation()) {\r\n        _e.nrJson = _e.toSslPath(_e.nrJson);\r\n        _e.json = _e.toSslPath(_e.json);\r\n        _e.testDataJson = _e.toSslPath(_e.testDataJson);\r\n    }\r\n    // 最新資料JSON\r\n    if (_e.nrJson) {\r\n        scriptLoader.setSrc(_e.nrJson + gt);\r\n    }\r\n    // テストJSON\r\n    if (_e.env.testMode) {\r\n        console.warn('テストデータを表示しています')\r\n        scriptLoader.setSrc(eirPassApp + 'json/' + _e.testDataJson + gt);\r\n    } else {\r\n        // 本番JSON\r\n        if (_e.isSet(_e.json)) {\r\n            scriptLoader.setSrc(_e.json + gt);\r\n            scriptLoader.setSrc(eirPassApp + \"json/announcement_extend.js\");\r\n        } else {\r\n            console.error('JSONのパスが指定されていません');\r\n        }\r\n    }\r\n    createJsonCallback();\r\n\r\n    scriptLoader.load(function(){\r\n        if(_e.env.testMode || _e.env.debug){\r\n            console.debug('env');\r\n            eirjQuery.each(_e.env, function(key){\r\n               console.debug('【' + key + '】: ' + this.toString()); \r\n            });\r\n\r\n            eirjQuery.each(_e.getArea(), function(){\r\n                console.debug('');\r\n                console.debug(this.areaName, this);\r\n            });\r\n        }\r\n    });\r\n}\r\n\r\nfunction setParts(fileName) {\r\n    // CSSを読み込む\r\n    eirjQuery('head').append('<link rel=\"stylesheet\" href=\"' + eirPassApp + 'css/main.css\">')\r\n             .append('<link rel=\"stylesheet\" href=\"' + eirPassApp + 'css/bootstrap_for_eir.css\">');\r\n\r\n    // テスト or デバッグモード\r\n    setEnvMode();\r\n\r\n    // キャッシュを無効化するためのクエリ\r\n    var gt = getCashQuery();\r\n    \r\n    // ファイル名を保存\r\n    _e.env.scriptName = fileName;\r\n    \r\n    // 読みこむスクリプトファイルを定義\r\n    scriptLoader.setSrc(unescape(eirPassMaterial + 'util/util.js' + gt));\r\n    scriptLoader.setSrc(unescape(eirPassApp + 'conf/common_conf.js' + gt));\r\n    scriptLoader.load(function(){\r\n\r\n        // テスト or デバッグモード\r\n        setEnvMode();\r\n\r\n        // キャッシュを無効化するためのクエリ\r\n        gt = getCashQuery();\r\n        scriptLoader.setSrc(unescape(eirPassCore + 'eir_main.js' + gt));\r\n        scriptLoader.setSrc(unescape(eirPassApp + 'custom.js' + gt));\r\n        scriptLoader.setSrc(unescape(eirPassApp + 'conf/' + fileName + '.js' + gt));\r\n        var addPage = eirjQuery('div[data-page-name]');\r\n        addPage.each(function(index){\r\n            scriptLoader.setSrc(unescape(eirPassApp + 'conf/' + eirjQuery(this).attr('data-page-name') + '.js' + gt));\r\n        });\r\n        if(typeof isUnifiedDrawingScriptMode != \"undefined\" && isUnifiedDrawingScriptMode){\r\n            scriptLoader.setSrc(unescape(eirPassApp + \"drawHtml.js\" + gt));\r\n        }else{\r\n            scriptLoader.setSrc(unescape(eirPassApp + fileName + \".js\" + gt));\r\n        }\r\n        \r\n        // JSON以外のスクリプトファイルをロード\r\n        scriptLoader.load(runEir);\r\n    });\r\n}\r\n\r\n_e.isNotExistJquery = false;\r\nif(typeof $ === 'undefined' && typeof jQuery === 'undefined'){\r\n    _e.isNotExistJquery = true;\r\n}\r\n\r\n/*! jQuery v3.5.1 | (c) JS Foundation and other contributors | jquery.org/license */\r\n!function(e,t){\"use strict\";\"object\"==typeof module&&\"object\"==typeof module.exports?module.exports=e.document?t(e,!0):function(e){if(!e.document)throw new Error(\"jQuery requires a window with a document\");return t(e)}:t(e)}(\"undefined\"!=typeof window?window:this,function(C,e){\"use strict\";var t=[],r=Object.getPrototypeOf,s=t.slice,g=t.flat?function(e){return t.flat.call(e)}:function(e){return t.concat.apply([],e)},u=t.push,i=t.indexOf,n={},o=n.toString,v=n.hasOwnProperty,a=v.toString,l=a.call(Object),y={},m=function(e){return\"function\"==typeof e&&\"number\"!=typeof e.nodeType},x=function(e){return null!=e&&e===e.window},E=C.document,c={type:!0,src:!0,nonce:!0,noModule:!0};function b(e,t,n){var r,i,o=(n=n||E).createElement(\"script\");if(o.text=e,t)for(r in c)(i=t[r]||t.getAttribute&&t.getAttribute(r))&&o.setAttribute(r,i);n.head.appendChild(o).parentNode.removeChild(o)}function w(e){return null==e?e+\"\":\"object\"==typeof e||\"function\"==typeof e?n[o.call(e)]||\"object\":typeof e}var f=\"3.5.1\",S=function(e,t){return new S.fn.init(e,t)};function p(e){var t=!!e&&\"length\"in e&&e.length,n=w(e);return!m(e)&&!x(e)&&(\"array\"===n||0===t||\"number\"==typeof t&&0<t&&t-1 in e)}S.fn=S.prototype={jquery:f,constructor:S,length:0,toArray:function(){return s.call(this)},get:function(e){return null==e?s.call(this):e<0?this[e+this.length]:this[e]},pushStack:function(e){var t=S.merge(this.constructor(),e);return t.prevObject=this,t},each:function(e){return S.each(this,e)},map:function(n){return this.pushStack(S.map(this,function(e,t){return n.call(e,t,e)}))},slice:function(){return this.pushStack(s.apply(this,arguments))},first:function(){return this.eq(0)},last:function(){return this.eq(-1)},even:function(){return this.pushStack(S.grep(this,function(e,t){return(t+1)%2}))},odd:function(){return this.pushStack(S.grep(this,function(e,t){return t%2}))},eq:function(e){var t=this.length,n=+e+(e<0?t:0);return this.pushStack(0<=n&&n<t?[this[n]]:[])},end:function(){return this.prevObject||this.constructor()},push:u,sort:t.sort,splice:t.splice},S.extend=S.fn.extend=function(){var e,t,n,r,i,o,a=arguments[0]||{},s=1,u=arguments.length,l=!1;for(\"boolean\"==typeof a&&(l=a,a=arguments[s]||{},s++),\"object\"==typeof a||m(a)||(a={}),s===u&&(a=this,s--);s<u;s++)if(null!=(e=arguments[s]))for(t in e)r=e[t],\"__proto__\"!==t&&a!==r&&(l&&r&&(S.isPlainObject(r)||(i=Array.isArray(r)))?(n=a[t],o=i&&!Array.isArray(n)?[]:i||S.isPlainObject(n)?n:{},i=!1,a[t]=S.extend(l,o,r)):void 0!==r&&(a[t]=r));return a},S.exte