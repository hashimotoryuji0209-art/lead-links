(var i = 0, ilen = items.length; i < ilen; i++){\r\n                item = items[i];\r\n                if(isSomeYearsAgo(new Date(), item.date, limit)){\r\n                    result[i] = item;\r\n                }\r\n            }\r\n\r\n            function isSomeYearsAgo(CurDate, CompDate, ago) {\r\n                var y = CompDate.substr(0, 4);\r\n                var m = CompDate.substr(5, 2);\r\n                var d = CompDate.substr(8, 2);\r\n\r\n                CurDate.setYear(CurDate.getFullYear() - ago);\r\n                if (CurDate <= new Date(y, m-1, d)) {\r\n                    return true;\r\n                }\r\n                return false;\r\n            }\r\n            return result;\r\n        };\r\n\r\n        MakeFilteredItems.prototype.allItem = function(expectValue, groupArr, groupType, items, area){\r\n            return items;\r\n        };\r\n\r\n        MakeFilteredItems.prototype.yearDefault = function(expectValue, groupArr, groupType, items, area){\r\n                \r\n            var result = [],\r\n                item;\r\n            expectValue = $.isArray(expectValue) ? expectValue : [expectValue];\r\n            \r\n            $.each(items, function(){\r\n                item = this;\r\n                $.each(expectValue, function(){\r\n                    if(item[groupType] == this){\r\n                        result[result.length] = item;\r\n                    }\r\n                });\r\n            });\r\n            return result;\r\n        };\r\n        \r\n        MakeFilteredItems.prototype.newsTypeDefault = function(expectValue, groupArr, groupType, items, area){\r\n            var result = []\r\n            , item\r\n            , dispAllItemFlg = false;\r\n\r\n            if(expectValue.news_type === 'ALL'){\r\n                dispAllItemFlg = true;\r\n            }else if(expectValue.news_type === '' || expectValue.news_type.length === 0){\r\n                if(expectValue.sub_type === '' || expectValue.sub_type.length === 0){\r\n                    dispAllItemFlg = true;   \r\n                }\r\n            }\r\n\r\n            for(var i = 0, len = items.length; i < len; i++){\r\n                item = items[i];\r\n\r\n                if(dispAllItemFlg\r\n                || expectValue.news_type.indexOf(item.news_type) > -1\r\n                || expectValue.sub_type.indexOf(item.sub_type) > -1){\r\n                    if(expectValue.javascript(item)){\r\n                        result.push(item);\r\n                    }\r\n                }\r\n            }\r\n            return result;\r\n        };\r\n\r\n    _e.makeFilteredItems = new MakeFilteredItems();\r\n    \r\n    \r\n\r\n    // ソート\r\n    (function defineSotrHelper(){\r\n        _e.sortHelper = {\r\n            // 日付の降順\r\n            date: function(a, b, conf){         \r\n                if (Date.parse(a.date) < Date.parse(b.date)) {\r\n                    return 1;\r\n                }\r\n                else if (Date.parse(a.date) > Date.parse(b.date)) {\r\n                    return -1;\r\n                }\r\n                return false;\r\n            },\r\n\r\n            // 日付の昇順\r\n            asc_date: function(a, b, conf){         \r\n                if (Date.parse(a.date) > Date.parse(b.date)) {\r\n                    return 1;\r\n                }\r\n                else if (Date.parse(a.date) < Date.parse(b.date)) {\r\n                    return -1;\r\n                }\r\n                return false;\r\n            },\r\n    \r\n            // 決算期の降順\r\n            fiscal_ym: function(a, b, conf){\r\n                if(Number(a.fiscal_ym) < Number(b.fiscal_ym)){\r\n                    return 1;\r\n                }\r\n                else if(Number(a.fiscal_ym) > Number(b.fiscal_ym)){\r\n                    return -1;\r\n                }else{\r\n                    var aPoint = _e.sortHelper.getSortPointQuarter(a.quarter, conf);\r\n                    var bPoint = _e.sortHelper.getSortPointQuarter(b.quarter, conf);\r\n\r\n                    if(aPoint < bPoint){\r\n                        return 1;\r\n                    }\r\n                    else if(aPoint > bPoint){\r\n                        return -1;\r\n                    }\r\n                }\r\n                return false;\r\n            },\r\n            // 決算期の降順,四半期の昇順\r\n            fiscal_ym_asc_quarter: function(a, b, conf){\r\n                if(Number(a.fiscal_ym) < Number(b.fiscal_ym)){\r\n                    return 1;\r\n                }\r\n                else if(Number(a.fiscal_ym) > Number(b.fiscal_ym)){\r\n                    return -1;\r\n                }else{\r\n                    var aPoint = _e.sortHelper.getSortPointQuarter(a.quarter, conf);\r\n                    var bPoint = _e.sortHelper.getSortPointQuarter(b.quarter, conf);\r\n\r\n                    if(aPoint > bPoint){\r\n                        return 1;\r\n                    }\r\n                    else if(aPoint < bPoint){\r\n                        return -1;\r\n                    }\r\n                }\r\n                return false;\r\n            },\r\n    \r\n            // 「管理画面：グループの順番」の降順\r\n            group_order: function(a, b, conf){\r\n                if(a.group_order > b.group_order){\r\n                    return 1;\r\n                }\r\n                else if(a.group_order < b.group_order){\r\n                    return -1;\r\n                }\r\n                return false;\r\n            },\r\n    \r\n            // 四半期の降順\r\n            quarter: function(a, b, conf){\r\n                var aPoint = _e.sortHelper.getSortPointQuarter(a.quarter, conf);\r\n                var bPoint = _e.sortHelper.getSortPointQuarter(b.quarter, conf);\r\n\r\n                if(aPoint < bPoint){\r\n                    return 1;\r\n                }\r\n                else if(aPoint > bPoint){\r\n                    return -1;\r\n                }\r\n                return false;\r\n            },\r\n            // 四半期の値の優先順序を作成\r\n            getSortPointQuarter: function(value, conf){\r\n                switch(value){\r\n                    case '4':\r\n                    case '0':\r\n                    case 4:\r\n                    case 0:\r\n                        return 4;\r\n                    break;\r\n//                     case '9':\r\n//                         return -1;\r\n//                     break;\r\n                    default:\r\n                        return Number(value);\r\n                    break;\r\n                }\r\n            },\r\n    \r\n            // conf.sort.newsTypesの配列に入っている要素の降順\r\n            news_type: function(a, b, conf){\r\n                var aPoint = _e.sortHelper.getSortPointNewsType(a, conf);\r\n                var bPoint = _e.sortHelper.getSortPointNewsType(b, conf);\r\n                if(aPoint < bPoint){\r\n                    return 1;\r\n                }\r\n                else if(aPoint > bPoint){\r\n                    return -1;\r\n                }\r\n                return false;\r\n            },\r\n            // ニュースタイプの優先順序を判定する\r\n            getSortPointNewsType: function(item, conf){\r\n                var newsTypes = conf.data.sort.newsTypes || [];\r\n                var point = 9999; // 9999はニュースタイプを指定する個数としてありえない数\r\n    \r\n                switch(item.news_type){\r\n                    case 'calendar':\r\n                    case 'announcement':\r\n                    case 'ir_material':\r\n                    case 'ir_material_for_fiscal_ym':\r\n                        if(newsTypes.indexOf(item.sub_type) > -1){\r\n                            return point - newsTypes.indexOf(item.sub_type);\r\n                        }\r\n                    break;\r\n                    default:\r\n                        if(newsTypes.indexOf(item.sub_type) > -1){\r\n                            return point - newsTypes.indexOf(item.sub_type);\r\n                        }\r\n                        else if(newsTypes.indexOf(item.news_type) > -1){\r\n                            return point - newsTypes.indexOf(item.news_type);\r\n                        }\r\n                    break;\r\n                }\r\n                return 0;\r\n            }\r\n        }\r\n    })();\r\n\r\n    (function defineControllerGenerater(){\r\n        /**\r\n        * 年コントローラのHTML要素を作成し、イベントを付与する\r\n        *\r\n        * @method generate\r\n        */\r\n        _e.YearController.prototype.generate = function(){\r\n            var groupArr     = this.groupArr,\r\n                group,\r\n                currentValue = this.currentValue,\r\n                $rootElement = $('<div class=\"yearController s_yearController\"></div>'),\r\n                that = this;\r\n                this.$rootElement = $rootElement;\r\n\r\n            /**\r\n            * htmlTemplate: button（旧メニューリンク,select以外）\r\n            */\r\n            if(this.htmlTemplate === 'button'){\r\n                \r\n                var $ul = $('<ul class=\"s_eirAnchor\"></ul>'),\r\n                    $li,\r\n                    $a,\r\n                    stateElms = []; // active, selectなど、現在選択されていることを示すクラス名を付与された、されるであろう要素\r\n\r\n                $rootElement.append($ul);\r\n\r\n                // 要素作成開始\r\n                $.each(groupArr, function(index){\r\n\r\n                    group = this;\r\n                    \r\n                    if(that.groupType != \"group_name\" && group == \"\")\r\n                        return true;\r\n\r\n                    switch(_e.typeOf(group)){\r\n                        case 'string':\r\n                            group = group.toString();\r\n                        break;\r\n                        case 'number':\r\n                            group = Number(group);\r\n                        break;\r\n                    }\r\n\r\n                    $li = $('<li class=\"activeTarget\"></li>').attr('data-' + that.dataAttr, index);\r\n                    $a = $('<a href=\"javascript:void(0)\">' + that.makeMidashi(group, a) + '</a>').attr('data-' + that.dataAttr, index);\r\n\r\n                    $li.append($a);\r\n                    $ul.append($li);\r\n                    stateElms.push($li);\r\n\r\n                    // 現在の値\r\n                    if(group === currentValue){\r\n                        $li.addClass(that.activeClass);\r\n                    } else if(_e.queryMap.year && group === groupArr[currentValue]){\r\n                        $li.addClass(that.activeClass);\r\n                        that.currentValue = groupArr[currentValue];\r\n                    }\r\n\r\n                    // イベントリスナ\r\n                    $a.on('click', function(){\r\n                        that.currentValue = groupArr[index];\r\n                        that.equalizeUiSelected($(this));\r\n                        _e.reDrawItemHtmlToAllArea();\r\n                    });\r\n                });\r\n            }\r\n            /**\r\n            * htmlTemplate: pullDown\r\n            */    \r\n            else if(this.htmlTemplate === 'pullDown'){\r\n                var $select = $('<select class=\"s_eirSelect\"></select>'),\r\n                    $option;\r\n                $rootElement.append($select);\r\n\r\n                // 要素作成開始\r\n                for(var a = 0, len = groupArr.length; a < len; a++){\r\n                    group = groupArr[a];\r\n\r\n                    if(this.groupType != \"group_name\" && group == \"\")\r\n                        continue;\r\n\r\n                    $option = $('<option value=\"' + a + '\">' + this.makeMidashi(group, a) + '</option>');\r\n                    $select.append($option);\r\n\r\n                    // 現在の値\r\n                    if(group === currentValue){\r\n                        $option.attr('selected', 'true');\r\n                    } else if(_e.queryMap.year && group === groupArr[currentValue]){\r\n                        $option.attr('selected', 'true');\r\n                        that.currentValue = groupArr[currentValue];\r\n                    }\r\n                }\r\n\r\n                // イベントリスナ\r\n                $select.on('change', function(){\r\n                    that.currentValue = groupArr[$(this).val()];\r\n                    that.equalizeUiSelected($(this));\r\n                    _e.reDrawItemHtmlToAllArea();\r\n                });\r\n            }else{\r\n                throw new Error('指定の年制御コントローラのUIが定義されていません [指定の名前: ' + this.htmlTemplate + ']');\r\n            }\r\n        };\r\n\r\n\r\n        /**\r\n        * ニュースタイプコントローラのHTML要素を作成し、イベントを付与する\r\n        *\r\n        * @method generate\r\n        */\r\n        _e.NewsTypeController.prototype.generate = function(){\r\n            var groupArr     = this.groupArr,\r\n                group,\r\n                currentValue = this.currentValue,\r\n                $rootElement = $('<div class=\"newsTypeController s_newsTypeController\"></div>'),\r\n                that = this;\r\n                this.$rootElement = $rootElement;\r\n\r\n            /**\r\n            * htmlTemplate: button（旧メニューリンク,select以外）\r\n            */\r\n            if(this.htmlTemplate === 'button'){\r\n\r\n                var $ul = $('<ul class=\"s_eirTab\"></ul>'),\r\n                    $li,\r\n                    $a,\r\n                    stateElms = [];\r\n\r\n                $rootElement.append($ul);\r\n\r\n                // 要素作成開始\r\n                $.each(groupArr, function(index){\r\n                    group = this;\r\n                    $li = $('<li class=\"activeTarget\"></li>').attr('data-' + that.dataAttr, index);\r\n                    $a = $('<a href=\"javascript:void(0)\">' + that.makeMidashi(group, a) + '</a>').attr('data-' + that.dataAttr, index);\r\n                    $li.append($a);\r\n                    $ul.append($li);\r\n                    stateElms.push($li);\r\n\r\n                    // 現在の値\r\n                    if(group === currentValue){\r\n                        $li.addClass(that.activeClass);\r\n                    } else if(_e.queryMap.news && group === groupArr[currentValue]){\r\n                        $li.addClass(that.activeClass);\r\n                        that.currentValue = groupArr[currentValue];\r\n                    }\r\n\r\n                    // イベントリスナ\r\n                    $a.on('click', function(){\r\n                        that.currentValue = groupArr[index];\r\n                        // that.setElmClassName($(this).parent(), stateElms);\r\n                        that.equalizeUiSelected($(this));\r\n                        _e.reDrawItemHtmlToAllArea();\r\n                    });\r\n                });\r\n            }\r\n            /**\r\n            * htmlTemplate: pullDown\r\n            */    \r\n            else if(this.htmlTemplate === 'pullDown'){\r\n                var $select = $('<select class=\"s_eirSelect\"></select>'),\r\n                    $option;\r\n                $rootElement.append($select);\r\n\r\n                // 要素作成開始\r\n                for(var a = 0, len = groupArr.length; a < len; a++){\r\n                    group = groupArr[a];\r\n                    $option = $('<option value=\"' + a + '\">' + this.makeMidashi(group, a) + '</option>');\r\n                    $select.append($option);\r\n\r\n                    // 現在の値\r\n                    if(group === currentValue){\r\n                        $option.attr('selected', 'true');\r\n                    } else if(_e.queryMap.news && group === groupArr[currentValue]){\r\n                        $option.attr('selected', 'true');\r\n                        that.currentValue = groupArr[currentValue];\r\n                    }\r\n                }\r\n\r\n                // イベントリスナ\r\n                $select.on('change', function(){\r\n                    that.currentValue = groupArr[$(this).val()];\r\n                    that.equalizeUiSelected($(this));\r\n                    _e.reDrawItemHtmlToAllArea();\r\n                });\r\n            }else{\r\n                throw new Error('指定のニュースタイプ制御コントローラのUIが定義されていません [指定の名前: ' + this.htmlTemplate + ']');\r\n            }\r\n        };\r\n    })();\r\n\r\n    // もっと見るぼたん\r\n    _e.makeMoreButton = function(area){\r\n        var $areaRoot = area.$rootElement,\r\n            $eirGroup = $areaRoot.find('.eirGroup'),\r\n            $head = $areaRoot.find('.eirHeading');\r\n\r\n        if(area.conf.htmlLevel == \"1\"){\r\n            $eirGroup = $areaRoot.find('.eirItem');\r\n        }\r\n\r\n        var showCount = area.conf.data.reDrawHtml.moreButton.numberOfDisplay,\r\n            $moreBtn = $('<div class=\"moreBtn s_eir_MoreBtn_link\"><a href=\"javascript:void(0)\">もっと見る</a></div>'),\r\n            amCount = 0;\r\n\r\n        var showHide = function($elm){\r\n            $.each($elm, function(i){\r\n                if(i <= showCount + amCount){\r\n                    if(area.conf.htmlLevel == \"1\" && ($(this).eq(0).hasClass(\"eirItem_child\")\r\n                                                    || $(this).eq(0).hasClass(\"attachmentItem\"))){\r\n                        amCount = amCount + 1;\r\n                    }\r\n                }\r\n                if(i < showCount + amCount){\r\n                    $(this).show();\r\n                }\r\n                else{\r\n                    $(this).hide();\r\n                }\r\n            });\r\n        }\r\n\r\n        showHide($eirGroup);\r\n        showHide($head);\r\n\r\n        if($eirGroup.length > showCount + amCount){\r\n            $areaRoot.append($moreBtn);\r\n        }\r\n        \r\n        $moreBtn.on('click', function(){\r\n            $eirGroup.fadeIn();\r\n            $head.fadeIn();\r\n            $(this).remove();\r\n        });\r\n    };\r\n\r\n    // アンカーリンク\r\n    _e.makeAnchorLink = function(area){\r\n        var conf = area.conf.data.reDrawHtml.anchorLink,\r\n            targetSelecter = conf.targetSelecter || '.eirHeading';\r\n\r\n        // アンカーリンクの紐付け先を決定する\r\n        var $anchorLinkRoot = area.$anchorLinkRoot,\r\n            $targetElements = area.$rootElement.find(targetSelecter), // リンク先となるHtML要素を取得する\r\n            htmlTemp = _e.htmlTemplate.anchorLink[conf.htmlTemplate] || _e.htmlTemplate.anchorLink.default,\r\n            valText;\r\n\r\n        var $wrap = $(htmlTemp.root),\r\n            $valueParent = _e.findElm($wrap, '.valueParent'),\r\n            $target, // アンカーリンク先の要素\r\n            string = 'target_id_' + area.areaName + '_',\r\n            innerText,\r\n            anchorText;\r\n\r\n        $anchorLinkRoot.append($wrap);\r\n\r\n        // ターゲット要素の数だけaタグ等のリンクを作成する\r\n        $targetElements.each(function(index){\r\n            \r\n            // 表示位置の変更\r\n            if(index === conf.position){\r\n                $(this).before($anchorLinkRoot);\r\n            }\r\n            if(index >= conf.position){\r\n                $target = $(this);\r\n                innerText = $target.text();\r\n                anchorText = string + index;\r\n                anchorText = anchorText.replace(/\\s/g, '');\r\n                $target.attr('id', anchorText);\r\n\r\n                // テンプレートにリンクと見出しのテキストをバインドしてjQueryオブジェクト化\r\n                valText = htmlTemp.value.replace(/%linkTarget%/, '#' + anchorText);\r\n                valText = valText.replace(/%formatGroupText%/, innerText);\r\n                $valueParent.append(valText);\r\n            }\r\n        });\r\n\r\n        if($('.eir_anchorLink').length){\r\n            $('.eir_anchorLink').append($anchorLinkRoot);\r\n        }\r\n\r\n        // '<div></div>'を消す\r\n        $anchorLinkRoot.get(0).outerHTML = $anchorLinkRoot.get(0).innerHTML;\r\n    };\r\n\r\n    // アコーディオン\r\n    _e.makeAccordion = function(area){\r\n        var conf = area.conf.data.reDrawHtml.accordion;\r\n        $(\".eir_area_\" + area.areaName  + ' .eirHeading').addClass('eirAccordionTrigger');\r\n        $(\".eir_area_\" + area.areaName  + ' .eirGroup').addClass('eirAccordionWrapper');\r\n        var trigger = $(\".eir_area_\" + area.areaName  + ' .eirAccordionTrigger');\r\n\r\n        if(trigger){\r\n            trigger.each(function(i){\r\n                if(i===conf.numberOfDisplay){\r\n                    return false;\r\n                }\r\n                $(this).addClass('eirAccordionTrigger-open');\r\n                $(this).next('.eirAccordionWrapper').addClass('eirAccordionWrapper-open');\r\n            });\r\n            trigger.on('click',function(){\r\n                $(this).toggleClass('eirAccordionTrigger-open');\r\n                $(this).next('.eirAccordionWrapper').slideToggle(function(){\r\n                    $(this).toggleClass('eirAccordionWrapper-open');\r\n                });\r\n            });\r\n        }\r\n    };\r\n\r\n    (function defineCategoryIconMethods(){\r\n        _e.getCategoryIconClass = function(item, area){\r\n            var ciConfs = area.conf.data.catIcon.icons;\r\n            var ciConf;\r\n            var jsResult;\r\n            for(var i in ciConfs){\r\n                ciConf = ciConfs[i];\r\n                if(ciConf.newsType.indexOf(item.news_type) > -1 || ciConf.subType.indexOf(item.sub_type) > -1){\r\n                    jsResult = i;\r\n                    break;\r\n                }\r\n            }\r\n\r\n            return 'cat-news-' + item.news_type + ' cat-sub-' + item.sub_type + ' cat-num-' + jsResult;\r\n        };\r\n        _e.getCategoryIconUrl = function(item) {\r\n            // ニュースタイプ\r\n            var nType = item.news_type;\r\n    \r\n            // お知らせ\r\n            if (nType.indexOf(\"announcement\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.sub_type + \".gif\";\r\n            }\r\n            // IR書類\r\n            else if (nType.indexOf(\"ir_material\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.sub_type + \".gif\";\r\n            }\r\n            // 短信系書類\r\n            else if (nType.indexOf(\"tanshin\") > -1 || nType.indexOf(\"pr\") > -1 || nType.indexOf(\"press\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.news_type + \".gif\";\r\n            }\r\n            // 有報\r\n            else if (nType.indexOf(\"yuho\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.news_type + \".gif\";\r\n            }\r\n            // コーポレートガバナンス報告書（内国株式）\r\n            else if (nType.indexOf(\"cgr_ds\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.news_type + \".gif\";\r\n            }\r\n            // コーポレートガバナンス報告書（内国株式以外）\r\n            else if (nType.indexOf(\"cgr_do\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.news_type + \".gif\";\r\n            }\r\n            // 株主総会招集通知\r\n            else if (nType.indexOf(\"gms\") > -1) {\r\n                return _e.getEirPassApp(\"img/category_icon/\") + item.news_type + \".gif\";\r\n            }\r\n            return \"\";\r\n        }\r\n    })();\r\n\r\n    _e.getFileTypeIconPath = function(item, area){\r\n        return  _e.getEirPassApp('img/filetype_icon/' + item.type + '.png');\r\n    };\r\n    \r\n\r\n    // 年グループのタイプを増やす\r\n    (function setYearTypeCallBacks(){\r\n        _e.customYearType.set([\r\n            {\r\n                name: 'calendar_year',\r\n                callback: function(){\r\n                    return Number(this.date.substr(0, 4));\r\n                }\r\n            },\r\n            {\r\n                name: 'nendo',\r\n                callback: function(){\r\n                    year = Number(this.date.substr(0,4));\r\n                    var month = Number(this.date.substr(5,2));\r\n                    return (month >= 4) ? year : year-1;\r\n                },  \r\n            },\r\n            {\r\n                name: 'fiscal_ym_quarter',\r\n                callback: function(){\r\n                    return this.fiscal_ym + ':' + this.quarter;\r\n                },\r\n            }\r\n        ]);\r\n    })();\r\n\r\n\r\n    // タイトルから決算期を取得する\r\n    (function setTitle2FyCallBacks(){\r\n        if(_e.getEnvLanguage() === 'jp'){\r\n            _e.title2Fy.set([\r\n                // 第何回\r\n                function(item, month) {\r\n                    var title = _e.makeTtl(item).replace(/\\s/, ''),\r\n                        yyyy;\r\n                    if( /第\\d+回/.test(title) ){\r\n                        yyyy = parseInt(title.match(/第(\\d+)回/)[1]) + Number(_e.baseYear);\r\n                        return yyyy + month;\r\n                    }\r\n                    return false;\r\n                },\r\n                // 第何期\r\n                function(item, month) {\r\n                    var title = _e.makeTtl(item).replace(/\\s/, ''),\r\n                        yyyy;\r\n                    if( /第\\d+期/.test(title) ){\r\n                        yyyy = parseInt(title.match(/第(\\d+)期/)[1]) + Number(_e.baseYear);\r\n                        return yyyy + month;\r\n                    }\r\n                    return false;\r\n                },\r\n                // 和暦\r\n                function(item, month) {\r\n                    var title = _e.makeTtl(item).replace(/\\s/, ''),\r\n                        yyyy,\r\n                        mm,\r\n                        warekiName = _e.getWarekiFromTitle(title),\r\n                        warekiReg;\r\n\r\n                    if( _e.gengou.wText2Seireki(title) ){\r\n                        yyyy = String(_e.gengou.wText2Seireki(title));\r\n                        if( /月期/.test(title) ){\r\n                            mm = parseInt(title.match(/年(\\d+)\\s*月期/)[1]);\r\n                            if(String(mm).length == 1){\r\n                                mm = '0' + mm;\r\n                            }\r\n                            return yyyy + '' + mm;\r\n                        }\r\n                        else{\r\n                            return yyyy + month;\r\n                        }\r\n                    }\r\n                    return false;\r\n                },\r\n                // 西暦\r\n                function(item, month) {\r\n                    var title = _e.makeTtl(item).replace(/\\s/, ''),\r\n                        yyyy,\r\n                        mm;\r\n\r\n                    if( /\\d{4}\\s*年/.test(title) ){\r\n                        yyyy = parseInt(title.match(/(\\d{4})\\s*年/)[1]);\r\n                        if( /月期/.test(title) ){\r\n                            mm = parseInt(title.match(/年(\\d+)\\s*月期/)[1]);\r\n                            if(String(mm).length == 1){\r\n                                mm = '0' + mm;\t\r\n                            }\r\n                            return yyyy + '' + mm;\r\n                        }\r\n                        else{\r\n                            return yyyy + month;\r\n                        }\r\n                    }\r\n                    return false;\r\n                }\r\n            ]);\r\n        }else{\r\n            // 英語用\r\n            _e.title2Fy.set([\r\n                // 西暦\r\n                function(item, month) {\r\n                    yyyy = item.title.match(/[0-9]{4}/);\r\n                    if(yyyy){\r\n                        return yyyy[0] + month;\r\n                    }\r\n                }\r\n            ]);\r\n        }\r\n    })();\r\n\r\n    // タイトルから四半期を取得する\r\n    (function setTitle2QuarterCallbacks(){\r\n        if(_e.getEnvLanguage() === 'jp'){\r\n            _e.title2Quarter.set([\r\n                function(item, fullYearReg){\r\n                    var title = _e.makeTtl(item).replace(/\\s/, '');\r\n                    if(/第1四半期/.test(title))          { return '10';}\r\n                    if(/第2四半期|上期|中間/.test(title)) { return '20';}\r\n                    if(/第3四半期/.test(title))          { return '30';}\r\n                    if(/通期/.test(title))     { return '100';}\r\n                    if(_e.typeOf(fullYearReg) === 'regexp' && fullYearReg.test(title))         { return '100'}\r\n                    // 決算期が存在する場合は、上記以外を通期とみなす\r\n                    if(_e.isSet(item.fiscal_ym)){\r\n                        return '100';\r\n                    }\r\n                }\r\n            ]);\r\n        }else{\r\n            _e.title2Quarter.set([\r\n                function(item, fullYearReg){\r\n                    var title = _e.makeTtl(item).replace(/\\s/g, '').toUpperCase();\r\n                    if(/1Q|Q1|FIRSTQUARTER/.test(title))        { return '10'; }\r\n                    if(/2Q|Q2|SECONDQUARTER/.test(title))       { return '20'; }\r\n                    if(/3Q|Q3|THIRDQUARTER/.test(title))        { return '30'; }\r\n                    if(/4Q|Q4|0Q|Q0|FOURTHQUARTER/.test(title)) { return '100'; }\r\n                    if(_e.typeOf(fullYearReg) === 'regexp' && fullYearReg.test(title))         { return '100'}\r\n                    // 決算期が存在する場合は、上記以外を通期とみなす\r\n                    if(_e.isSet(item.fiscal_ym)){\r\n                        return '100';\r\n                    }\r\n                }\r\n            ]);\r\n        }\r\n    })();\r\n\r\n    // StringShooterの設定\r\n    (function setStringShooterCallBacks(){\r\n        _e.stringShooter.set([\r\n            // RSS\r\n            {\r\n                selecter: '[class*=\"eirTarget_rss_\"]',\r\n                callback: function($target, strings){\r\n                    var number\r\n                      , reg = /eirTarget_rss_([0-9]{0,10})/;\r\n                    $target.each(function(){\r\n                        number = getSuffix(reg, $(this).attr('class'));\r\n                        $(this).html(strings.getRssText(number));\r\n                    });\r\n                }\r\n            },\r\n            // 有報財務CSV\r\n            {\r\n                selecter: '[class*=\"eirTarget_yuhoCsv_\"]',\r\n                callback: function($target, strings){\r\n                    var number\r\n                      , reg = /eirTarget_yuhoCsv_([0-9]{0,10})/;\r\n                    $target.each(function(){\r\n                        number = getSuffix(reg, $(this).attr('class'));\r\n                        $(this).html(strings.getYuhoCsvText(number));\r\n                    });\r\n                }\r\n            },\r\n            // 一括ダウンロード\r\n            {\r\n                selecter: '.eirTarget_zipDownload',\r\n                callback: function($target, strings){\r\n                    if(_e.isSet(_e.nrData) && _e.isSet(_e.nrData.output_url)){\r\n                        $target.html('<a href=\"' + _e.nrData.output_url + '\" target=\"_blank\">一括ダウンロード（' + _e.nrData.zip_size + 'KB）</a>');\r\n                    }\r\n                }\r\n            },\r\n            // 一括ダウンロードファイルサイズ\r\n            {\r\n                selecter: '.eirTarget_zipDownloadSize',\r\n                callback: function($target, strings){\r\n                    if(_e.isSet(_e.nrData) && _e.isSet(_e.nrData.output_url)){\r\n                        $target.append(_e.nrData.zip_size);\r\n                    }\r\n                }\r\n            },\r\n            // 有報注記\r\n            {\r\n                selecter: '.eirTarget_yuhoNote',\r\n                callback: function($target, strings){\r\n                    $target.html(strings.getYuhoNoteText());   \r\n                }\r\n            },\r\n            // PDF注記\r\n            {\r\n                selecter: '.eirTarget_pdfNote',\r\n                callback: function($target, strings){\r\n                    $target.html(strings.getPdfNoteText());\r\n                }\r\n            },\r\n            // PNEX注記\r\n            {\r\n                selecter: '.eirTarget_pnexNote',\r\n                callback: function($target, strings){\r\n                    $target.html(strings.getPnexNoteText());\r\n                }\r\n            },\r\n            // src属性\r\n            {\r\n                selecter: '.eirAttrTarget_img',\r\n                callback: function($target, strings){\r\n                    var val = $target.data('eir-val');\r\n                    $target.attr('src', _e.getEirPassApp('img/' + val));\r\n                }\r\n            },\r\n            // RSSURL\r\n            {\r\n                selecter: '[class*=\"eirAttrTarget_rss_\"]',\r\n                callback: function($target, strings){\r\n\r\n                    var number\r\n                      , reg = /eirAttrTarget_rss_([0-9]{0,10})/\r\n                      , tpl = '%eirUrl%/V4Public/EIR/%eirCode%/ja/announcement/announcement_%rssNo%.xml'.replace(/%eirCode%/,  _e.getEirCode())\r\n                                                                                                        .replace(/%eirUrl%/,  _e.getEirUrl());\r\n                    if(_e.getEnvLanguage()==='en'){\r\n                        tpl = tpl.replace(/ja/, 'en');\r\n                    }\r\n                    $target.each(function(){\r\n                        number = getSuffix(reg, $(this).attr('class'));\r\n                        $(this).attr('href', tpl.replace(/%rssNo%/, number));\r\n                    });\r\n                }\r\n            },\r\n            // 有報CSVURL\r\n            {\r\n                selecter: '[class*=\"eirAttrTarget_yuhoCsv_\"]',\r\n                callback: function($target, strings){\r\n                    var number\r\n                      , reg = /eirAttrTarget_yuhoCsv_([0-9]{0,10})/\r\n                      , tpl = '%eirUrl%/Custom/public/material/csv/yuho_csv.html?code=%eirCode%&yuho=★★YUHO_NUMBER★★&cname=1&lang=ja'.replace(/%eirCode%/g, _e.getEirCode())\r\n                                                                                                                               .replace(/%eirUrl%/g, _e.getEirUrl());\r\n                    if(_e.getEnvLanguage()==='en'){\r\n                        tpl = tpl.replace(/ja/, 'en');\r\n                    }\r\n                    $target.each(function(){\r\n                        number = getSuffix(reg, $(this).attr('class'));\r\n                        $(this).attr('href', tpl.replace(/★★YUHO_NUMBER★★/, number));\r\n                    });\r\n                }\r\n            },\r\n            {\r\n                selecter: '.eirAttrTarget_zipDownloadUrl',\r\n                callback: function($target, strings){\r\n                    if(!_e.isSet(_e.nrData) || !_e.isSet(_e.nrData.output_url)){\r\n                        return;\r\n                    }\r\n                    $target.attr('href', _e.nrData.output_url);\r\n                }\r\n            },\r\n            // 最新年情報\r\n            {\r\n                selecter: '[class*=\"eirTarget_latestFiscalYm_\"]',\r\n                callback: function($target, strings){\r\n                    var areaname\r\n                      , reg = /eirTarget_latestFiscalYm_([a-zA-Z0-9_]+)/;\r\n                    $target.each(function(){\r\n                        var thisTarget = this;\r\n                        areaname = getSuffix(reg, $(this).attr('class'));\r\n                        $(_e.areaArr).each(function(){\r\n                            if(this.areaName===areaname && this.data.currentFY){\r\n                                var currentYear = new FormatGroupText();\r\n                                currentYear.init(\"fiscal_ym\", this.data.currentFY, _e.context.MAKE_YEAR_MIDASHI, this);\r\n                                $(thisTarget).html(currentYear.fiscal_ym());\r\n                            }\r\n                        });                        \r\n                    });\r\n                }\r\n            },\r\n            // 最新四半期情報\r\n            {\r\n                selecter: '[class*=\"eirTarget_latestQuarter_\"]',\r\n                callback: function($target, strings){\r\n                    var areaname\r\n                      , reg = /eirTarget_latestQuarter_([a-zA-Z0-9_]+)/;\r\n                    $target.each(function(){\r\n                        var thisTarget = this;\r\n                        areaname = getSuffix(reg, $(this).attr('class'));\r\n                        $(_e.areaArr).each(function(){\r\n                            if(this.areaName===areaname && this.data.currentQuarter!=='100'){\r\n                                $(thisTarget).html(strings.getQuarterText(this.data.currentQuarter));\r\n                            }\r\n                        });                        \r\n                    });\r\n                }\r\n            },\r\n            // カレンダー画像\r\n            {\r\n                selecter: '.eirTarget_calendarImg',\r\n                callback: function($target, strings){\r\n                    $target.html(strings.getCalendarImageText());   \r\n                }\r\n            },\r\n        ]);\r\n\r\n        // matchの[1]を取得する\r\n        function getSuffix(reg, text){\r\n            if(reg.test(text)){\r\n                return text.match(reg)[1];\r\n            }\r\n            return null;\r\n        };\r\n    })();\r\n\r\n\t_e.makePager = function(area){\r\n        let Items = area.data.filtedItems;\r\n        var current_page = 1;\r\n        let $areaRoot = area.$rootElement;\r\n        let pagerDisplayNumber = area.conf.data.reDrawHtml.pager.numberOfDisplay;\r\n\r\n        if($('.eir_area_' + area.areaName + ' .eir-pager .pagination').length < 1){\r\n            $areaRoot.append($('<div class=\"eir-pager\"><div class=\"pagination\"></div></div>'));\r\n        }\r\n\r\n        var pageSize = Math.floor(Items.length/pagerDisplayNumber);\r\n        if(Math.floor(Items.length%pagerDisplayNumber)){\r\n            pageSize = pageSize + 1;\r\n        }\r\n\r\n        _e.displayPager(current_page, pageSize, area);\r\n\r\n        var $eirGroup = $('.eir_area_' + area.areaName + ' .eirGroup li');\r\n        _e.pagerShowHideItem($eirGroup, current_page, area);\r\n\r\n        var $eirBlock = $('.eir_area_' + area.areaName + ' .eirBlock');\r\n        _e.pagerShowHideHead($eirBlock);\r\n\r\n        $eirBlock.find('.eirItem:visible').first().find('.eirItem_date').removeClass('s_eirList_item_date_hidden');\r\n    };\r\n\r\n    _e.changeSelectedPager = function($selected, area){\r\n        let pagerDisplayNumber = area.conf.data.reDrawHtml.pager.numberOfDisplay;\r\n        //選択状況を取得\r\n        var selectedNumber = $selected[0].innerText;\r\n        var current_page = $('.eir_area_' + area.areaName + ' .pagination span.current').data('pager');\r\n        var pageSize = $('.eir_area_' + area.areaName + ' .pagination span.page').length;\r\n        if(typeof current_page === \"undefined\")\r\n            current_page = 1;\r\n        if(selectedNumber[0] == '‹')\r\n            current_page = current_page - 1;\r\n        else if(selectedNumber[0] == '次')\r\n            current_page = current_page + 1;\r\n        else\r\n            current_page = selectedNumber;\r\n\r\n        _e.displayPager(current_page, pageSize, area);\r\n\r\n        var $eirGroup = $('.eir_area_' + area.areaName + ' .eirGroup li');\r\n        _e.pagerShowHideItem($eirGroup, current_page, area);\r\n\r\n        var $eirBlock = $('.eir_area_' + area.areaName + ' .eirBlock');\r\n        _e.pagerShowHideHead($eirBlock);\r\n\r\n        $eirBlock.find('.eirItem:visible').first().find('.eirItem_date').removeClass('s_eirList_item_date_hidden');\r\n    };\r\n\r\n    _e.displayPager = function(current_page, pageSize, area){\r\n        let pagerDisplayNumber = area.conf.data.reDrawHtml.pager.numberOfDisplay;\r\n        var $pager = $('.eir_area_' + area.areaName + ' .pagination');\r\n        $pager.empty();\r\n        if(current_page != 1)\r\n            $pager.append($('<span class=\"prev\"><a href=\"javascript:void(0)\" rel=\"next\">&lsaquo; 前の' + pagerDisplayNumber +'件</a></span>'));\r\n\r\n        // 要素作成開始\r\n        for(var a = 1, len = pageSize; a <= len; a++){\r\n            if(current_page != a){\r\n                $span = $('<span class=\"page\"></span>').attr('data-pager', a);\r\n                $a = $('<a href=\"javascript:void(0)\" rel=\"next\">' + a + '</a>');\r\n                $span.append($a);\r\n                $pager.append($span);\r\n            }\r\n            else{\r\n                $pager.append($('<span class=\"page current\">' + a + '</span>').attr('data-pager', a));\r\n            }\r\n        }\r\n        if(current_page < ($('.eir_area_' + area.areaName + ' .pagination span.page').length) )\r\n            $pager.append($('<span class=\"next\"><a href=\"javascript:void(0)\" rel=\"next\">次の' + pagerDisplayNumber + '件 &rsaquo;</a></span>'));\r\n\r\n        //イベントリスナ\r\n        $('.eir_area_' + area.areaName + ' .pagination a').on('click', function(){\r\n            _e.changeSelectedPager($(this), area);\r\n        });\r\n    };\r\n\r\n    _e.pagerShowHideItem = function($elm, current_page, area){\r\n        let pagerDisplayNumber = area.conf.data.reDrawHtml.pager.numberOfDisplay;\r\n        $.each($elm, function(i){\r\n            if( ((current_page-1)*pagerDisplayNumber <= i) && (i < current_page*pagerDisplayNumber)){\r\n                $(this).show();\r\n            }\r\n            else{\r\n                $(this).hide();\r\n            }\r\n        });\r\n    }\r\n\r\n    _e.pagerShowHideHead = function($elm){\r\n        $.each($elm, function(i){\r\n            let isVisible = false;\r\n            $.each($(this).find('.eirItem'), function(i){\r\n                if($(this).is(':visible')){\r\n                    isVisible = true; \r\n                }\r\n            });\r\n            if(isVisible){\r\n                $(this).find('.eirHeading').show();\r\n            }\r\n            else{\r\n                $(this).find('.eirHeading').hide();\r\n            }\r\n        });\r\n    }\r\n\r\n    _e.getAppendTplTarget = function(item){\r\n        if(item.sub_type.match('custom')){\r\n            return item.sub_type;\r\n        }\r\n\r\n        switch(item.news_type){\r\n            case 'ir_material':\r\n            case 'ir_material_for_fiscal_ym':\r\n            case 'announcement':\r\n            case 'calendar':\r\n                return item.sub_type;\r\n            default:\r\n                return item.news_type;\r\n        }\r\n    };\r\n\r\n    }(EIR, eirjQuery));\r\n   "
