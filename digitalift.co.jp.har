            "text": "@charset \"UTF-8\";\r\n/*!\r\n* Bootstrap v4.0.0 (https://getbootstrap.com)\r\n* Copyright 2011-2018 The Bootstrap Authors\r\n* Copyright 2011-2018 Twitter, Inc.\r\n* Licensed under MIT (https://github.com/twbs/bootstrap/blob/master/LICENSE)\r\n*/\r\n\r\n.eirUseText *, .eirUseText ::after, .eirUseText ::before {\r\n  box-sizing: border-box;\r\n}\r\n.eirUseText{\r\n  font-family: sans-serif;\r\n  line-height: 1.15;\r\n  -webkit-text-size-adjust: 100%;\r\n  -ms-text-size-adjust: 100%;\r\n  -ms-overflow-style: scrollbar;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n.eirUseText article, .eirUseText aside, .eirUseText dialog, .eirUseText figcaption, .eirUseText figure, .eirUseText footer, .eirUseText header, .eirUseText hgroup, .eirUseText main, .eirUseText nav, .eirUseText section {\r\n  display: block;\r\n}\r\n.eirUseText{\r\n  margin: 0;\r\n  font-family: -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\";\r\n  font-size: 1rem;\r\n  font-weight: 400;\r\n  line-height: 1.5;\r\n  color: #212529;\r\n  text-align: left;\r\n  background-color: #fff;\r\n}\r\n.eirUseText [tabindex=\"-1\"]:focus {\r\n  outline: 0 !important;\r\n}\r\n.eirUseText hr {\r\n  box-sizing: content-box;\r\n  height: 0;\r\n  overflow: visible;\r\n}\r\n.eirUseText h1, .eirUseText h2, .eirUseText h3, .eirUseText h4, .eirUseText h5, .eirUseText h6 {\r\n  margin-top: 0;\r\n  margin-bottom: 0.5rem;\r\n}\r\n.eirUseText p {\r\n  margin-top: 0;\r\n  margin-bottom: 1rem;\r\n}\r\n.eirUseText abbr[data-original-title], .eirUseText abbr[title] {\r\n  text-decoration: underline;\r\n  -webkit-text-decoration: underline dotted;\r\n  text-decoration: underline dotted;\r\n  cursor: help;\r\n  border-bottom: 0;\r\n}\r\n.eirUseText address {\r\n  margin-bottom: 1rem;\r\n  font-style: normal;\r\n  line-height: inherit;\r\n}\r\n.eirUseText dl, .eirUseText ol, .eirUseText ul {\r\n  margin-top: 0