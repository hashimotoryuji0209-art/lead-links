                    $highestLevelTpl.append($year);\r\n                }\r\n                \r\n                if(yearTpl){\r\n                    $parentItem = $year;\r\n                }\r\n                else{\r\n                    $parentItem = $highestLevelTpl;\r\n                }\r\n\r\n                // 書類のHTMLを作成\r\n                tmp = itemTpl.replace(/%year%/g, yearVal)\r\n                .replace(/%quarter%/g, quarterVal);\r\n\r\n                if(memo.isFirst){\r\n                    const nDate = new Date();\r\n                    const nMonth = nDate.getMonth() + 1;\r\n                    const eYear = item.fiscal_ym.substr(0,4);\r\n                    const eMonth = item.fiscal_ym.substr(4,2) - 1;\r\n                    let cDate = new Date(eYear,eMonth,1);\r\n                    cDate.setMonth(cDate.getMonth() - 11);\r\n\r\n                    for(var i = 0; i < 12; i++){\r\n                        tmp = itemTpl;\r\n                        tmp = tmp.replace(/%nen%/g, cDate.getFullYear());    \r\n                        tmp = tmp.replace(/%tsuki%/g, cDate.getMonth()+1);\r\n                        \r\n                        $tsuki = $(tmp);\r\n                        if(i != 0 && cDate.getMonth() != 0){\r\n                            $tsuki.find('.eirCalendar_year').remove();\r\n                        }\r\n                        if(cDate.getMonth()+1 == nMonth){\r\n                            $tsuki.addClass(\"eirCalendar_now\")\r\n                        }\r\n                        $tsuki.addClass(mNames[cDate.getMonth()]);\r\n                        \r\n                        _e.appendTpl($parentItem, $tsuki, 'loop-item');\r\n\r\n                        cDate.setMonth(cDate.getMonth() + 1);\r\n                    }\r\n\r\n                    memo.isFirst = false;\r\n                }\r\n\r\n                let itemMonth = Number(item.date.substr(5,2))-1;\r\n                tmp = attachmentTpl;\r\n                tmp = tmp.replace(/%title%/g, _e.makeTtl(item, area));\r\n                $parentItem.find(\".\"+mNames[itemMonth]).append(tmp);\r\n            }\r\n        \r\n        },\r\n        /**\r\n        * HTML要素作成のヘルパー\r\n        *\r\n        * @method crHtml\r\n        * @param {Object} arg.tagText     // 作成する要素の文字列 例：'<div><p></p></div>'\r\n        * @param {Object} arg.valueText   // 作成したHTML要素に対して追加する文字列\r\n        * @param {Object} arg.$parent     // \r\n        * @param {Object} arg.getSelecter // 作成した要素のうち、返り値となるHTML要素のセレクタ\r\n        * @return {Object} $elm           // jqueryオブジェクト\r\n        */\r\n        crHtml: function(arg){\r\n            var tagText = arg.tagText,\r\n                valueText = arg.valueText,\r\n                $parent = arg.$parent,\r\n                getSelecter = arg.getSelecter,\r\n                $elm = $(tagText);\r\n    \r\n                if(valueText){\r\n                    $elm.html(valueText);\r\n                }\r\n                if($parent){\r\n                    $parent.append($elm);\r\n                }\r\n                if(getSelecter){\r\n                    return _e.findElm($elm, getSelecter);\r\n                }\r\n            return $elm;\r\n        },\r\n    \r\n        /**\r\n        * 年の見出しのHTMLを作成します\r\n        *\r\n        * @method crHeadHtml\r\n        * @param arg {Object}\r\n        */\r\n        crHeadHtml: function(arg){\r\n            var groupType = arg.groupType,\r\n                value = arg.value,\r\n                htmlTemplate = arg.htmlTemplate,\r\n                formatGroupText = arg.formatGroupText,\r\n                $parent = arg.$parent,\r\n                area = arg.area,\r\n                $yearHead;\r\n    \r\n            _e.formatGroupText.init(groupType, value, _e.context.MAKE_YEAR_MIDASHI, area);\r\n    \r\n            if(formatGroupText){\r\n                htmlTemplate = htmlTemplate.replace(/%heading%/, formatGroupText.apply(_e.formatGroupText));\r\n            }\r\n            else{\r\n                htmlTemplate = htmlTemplate.replace(/%heading%/, formatGroupText[groupType].apply(_e.formatGroupText));\r\n            }\r\n    \r\n            $yearHead = $(htmlTemplate);\r\n            $parent.append($yearHead);\r\n            return $yearHead;\r\n        },\r\n    \r\n        /**\r\n        * 元createData()\r\n        *\r\n        * @method makeItemHtml\r\n        * @param {Object}\r\n        * @param {Object}\r\n        * @return {Object}\r\n        */\r\n        makeItemHtml: function(item, htmlTemp, isChildItem, area){\r\n            var conf = area.conf;\r\n            \r\n            // 文字列のテンプレートに値をバインディングしていく\r\n            if(item.reOpts){\r\n                item.reOpts.forEach(function (opt, index){\r\n                    let re = new RegExp(\"%opt\" +  index + \"%\", \"g\");\r\n                    htmlTemp = htmlTemp.replace(re, opt);    \r\n                });\r\n            }\r\n\r\n            // 日付\r\n            if(conf.calendarMode){\r\n                if(item.news_type === 'calendar' && item.display_date !== ''){\r\n                    htmlTemp = htmlTemp.replace(/%format_date%/g, item.display_date);    \r\n                }else if(item.news_type === 'ir_material' && item.comment !== ''){\r\n                    htmlTemp = htmlTemp.replace(/%format_date%/g, item.comment);\r\n                }else{\r\n                    htmlTemp = htmlTemp.replace(/%format_date%/g, item.format_date);\r\n                }\r\n            }else{\r\n                htmlTemp = htmlTemp.replace(/%format_date%/g, item.format_date);\r\n            }\r\n    \r\n            htmlTemp = htmlTemp.replace(/%category_class%/g, _e.getCategoryIconClass(item, area));\r\n    \r\n            htmlTemp = htmlTemp.replace(/%category_icon%/g, _e.getCategoryIconText(item, conf));\r\n            htmlTemp = htmlTemp.replace(/%category_icon_second%/g, _e.getCategoryIconTextSecond(item, conf));\r\n    \r\n            // textの内容を表示させるためのリンク\r\n            if(conf.data.useText === 'guidLink' && item.text != ''){\r\n                htmlTemp = htmlTemp.replace(/%link%/g, conf.data.textHtmlPath + '?guid=' + item.guid);\r\n            }\r\n            else{\r\n                // 登録されている書類を表示するためのリンク\r\n                htmlTemp = htmlTemp.replace(/%link%/g, item.link);\r\n            }\r\n    \r\n            htmlTemp = htmlTemp.replace(/%target%/g, item.new_target);\r\n    \r\n            htmlTemp = htmlTemp.replace(/%title%/g, _e.makeTtl(item, area) );\r\n    \r\n            htmlTemp = htmlTemp.replace(/%type_upper%/g, item.type.toUpperCase());\r\n            htmlTemp = htmlTemp.replace(/%type%/g, item.type);\r\n    \r\n            htmlTemp = htmlTemp.replace(/%file_size%/g, item.file_size);\r\n\r\n            htmlTemp = htmlTemp.replace(/%page_num%/g, item.page_num);\r\n    \r\n            htmlTemp = htmlTemp.replace(/%text%/g, item.text);\r\n    \r\n            htmlTemp = htmlTemp.replace(/%comment%/g, item.comment);\r\n\r\n\r\n            \r\n            if(item.quarter){\r\n                htmlTemp = htmlTemp.replace(/%item_quarter%/g, 'q_'+item.quarter);\r\n            }\r\n            else {\r\n                htmlTemp = htmlTemp.replace(/%item_quarter%/g, 'q_0');\r\n            }\r\n\r\n            if(item.thumbnail_link) {\r\n                htmlTemp = htmlTemp.replace(/%thumnail_existence%/g, 'thum_true');\r\n            }\r\n            else {\r\n                htmlTemp = htmlTemp.replace(/%thumnail_existence%/g, 'thum_false');\r\n            }\r\n\r\n            // NEW\r\n            var fDate = _e.GetFormatDate(item.date);\r\n            if (!conf.data.newIcon.enable || Number(fDate) < Number(_e.GetComputeDate(conf.data.newIcon.limit))) {\r\n                htmlTemp = htmlTemp.replace(/%new%/g, 'past');\r\n            }\r\n            else {\r\n                htmlTemp = htmlTemp.replace(/%new%/g, 'new');\r\n            }\r\n            \r\n\r\n            // DOM化\r\n            var $itemElement = $(htmlTemp);\r\n\r\n            // jQuerのfindメソッドは第1階層の要素を取得できないので、コンテナに入れる\r\n            var $tmp = $itemElement.prop('tagName') == 'TR' ? _e.$tmpTbl : _e.$tmpDiv;\r\n            $tmp.empty().append($itemElement);\r\n\r\n            // 追加資料等判別用のクラス付与\r\n            if(item.is_attachment_item){\r\n                $itemElement.addClass('attachmentItem');\r\n                if(area.conf.data.attachment.date){\r\n                    $itemElement.addClass('dateAvailable');\r\n                }\r\n                if(item.is_attachment_first_item){\r\n                    $itemElement.addClass('attachmentFirstItem');\r\n                }\r\n                if(item.is_attachment_last_item){\r\n                    $itemElement.addClass('attachmentLastItem');\r\n                }\r\n            }\r\n\r\n            // 左部要素\r\n            if(conf.data.itemHead == false){\r\n                $tmp.find('.eirItem_head').remove();\r\n            }\r\n            // 日付\r\n            if(item.is_sameDay_item){\r\n                $tmp.find('.eirItem_date').addClass('s_eirList_item_date_hidden');\r\n            }\r\n            // サムネイル\r\n            if(conf.data.thumbFlg == false || item.thumbnail_link == ''){\r\n                $tmp.find('.eirItem_thumb').remove();\r\n            }\r\n            else{\r\n                $tmp.find('.eirItem_thumb_image').attr('src', item.thumbnail_link);\r\n            }\r\n\r\n            // 訂正\r\n            if(isChildItem){\r\n                $itemElement.addClass('eirItem_child');\r\n            }\r\n            else{\r\n                $tmp.find('.eirItem_rule').remove();\r\n            }\r\n    \r\n            // カテゴリアイコン\r\n            if(conf.data.catIcon.enable == false){\r\n                $tmp.find('.eirItem_category').remove();\r\n            }\r\n            // カテゴリアイコン2nd\r\n            if(conf.data.catIcon2nd.enable == false){\r\n                $tmp.find('.eirItem_category_second').remove();\r\n            }\r\n\r\n            // リンク\r\n            if(conf.data.useText === 'guidLink'){\r\n                if(item.link == '' && item.text == ''){\r\n                    $tmp.find('.eirItem_title_link').remove();\r\n                }\r\n                else{\r\n                    $tmp.find('.eirItem_title_text').remove();\r\n                }\r\n            }else{\r\n                if(item.link == ''){\r\n                    $tmp.find('.eirItem_title_link').remove();\r\n                }\r\n                else{\r\n                    $tmp.find('.eirItem_title_text').remove();\r\n                }\r\n            }\r\n    \r\n            // PDFアイコン\r\n            $tmp.find('.eirItem_type_icon_image').attr('src', _e.getFileTypeIconPath(item, area))\r\n            \r\n            // ファイルサイズ\r\n            if(item.file_size == ''){\r\n                $tmp.find('.eirItem_size').remove();\r\n            }\r\n\r\n            // 頁数\r\n            if(conf.data.pageNum == false || item.page_num == ''){\r\n                $tmp.find('.eirItem_page_num').remove();\r\n            }\r\n\r\n            // NEWアイコン\r\n            var fDate = _e.GetFormatDate(item.date);\r\n            if (!conf.data.newIcon.enable || Number(fDate) < Number(_e.GetComputeDate(conf.data.newIcon.limit))) {\r\n                $tmp.find('.eirItem_new').remove();\r\n            }\r\n    \r\n            if(conf.data.useText !== 'bind'){\r\n                $tmp.find('.eirItem_text').remove();\r\n            }\r\n    \r\n            // コメント\r\n            var commentFlg = true;\r\n            if(conf.data.hiddenComment != ''){\r\n                for(var c = 0; c < conf.data.hiddenComment.length; c++){\r\n                    switch(item.news_type){\r\n                        case 'ir_material':\r\n                        case 'ir_material_for_fiscal_ym':\r\n                        case 'announcement':\r\n                        if(item.sub_type == conf.data.hiddenComment[c]){\r\n                            commentFlg = false;\r\n                        }\r\n                        break;  \r\n    \r\n                        default:\r\n                        if(item.news_type == conf.data.hiddenComment[c]){\r\n                            commentFlg = false;\r\n                        }\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n    \r\n            if(conf.irMeeting || commentFlg == false || item.comment == '' ){\r\n                $tmp.find('.eirItem_comment').remove();\r\n            }\r\n    \r\n            // 別ページリンクのテキスト機能\r\n            if(conf.data.useText === 'guidLink' && item.text.length > 0){\r\n                $tmp.find('.eirItem_title_link').attr('target', '_top');\r\n            }\r\n            return $tmp.children();\r\n        },\r\n    \r\n    \r\n        /**\r\n        * RSSやPDFの注記など、areaの外にHTMLを描写する\r\n        * 全てのareaオブジェクトに対してHTMLが描写された後に実行される\r\n        * \r\n        * @method drawHtmlToPage\r\n        */\r\n        drawHtmlToPage: function(){\r\n            $(function(){\r\n                _e.stringShooter.shoot();\r\n            });\r\n        }\r\n    }\r\n    \r\n    $.extend(_e, drawHtml);\r\n    \r\n    \r\n    }(EIR, eirjQuery));\r\n"
          },
