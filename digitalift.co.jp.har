    var fiscal_ym = this.value.fiscal_ym;\r\n                    this.value.seirekiYear = fiscal_ym.substr(0,4);\r\n                    this.value.month = fiscal_ym.substr(4, 1) === '0' ? fiscal_ym.substr(5, 1) : fiscal_ym.substr(4, 2);\r\n                    this.value.warekiName = _e.gengou.getName(fiscal_ym);\r\n                    this.value.warekiYear = _e.gengou.getWareki(fiscal_ym);\r\n                    this.value.nen = '年';\r\n\r\n                    if(this.fyFormat == 'NENDO' && this.value.month < 4){\r\n                        this.value.seirekiYear = this.value.seirekiYear - 1;\r\n                        this.value.warekiName = _e.gengou.getName(this.value.seirekiYear + '04');\r\n                        this.value.warekiYear = _e.gengou.getWareki(this.value.seirekiYear + '04'); \r\n                    }\r\n                    if(this.fyFormat == 'NENDO'){\r\n                        this.value.nen = '年度';\r\n                    }\r\n\r\n                    this.value.gatsuki = '';\r\n                    if(this.fyFormat == 'YM'){\r\n                        this.value.gatsuki =  this.value.month + '月期';\r\n                    }\r\n\r\n                    this.value.times = Number(this.value.seirekiYear) - Number(_e.baseYear);\r\n\r\n                    this.value[groupType] = groupVal;\r\n                break;\r\n\r\n                case /nendo/.test(groupType):\r\n                    this.value.seirekiYear = groupVal;\r\n                    this.value.warekiName = _e.gengou.getName(groupVal + \"04\");\r\n                    this.value.warekiYear = _e.gengou.getWareki(groupVal + \"04\");\r\n                    this.value.nen = '年度';\r\n                    this.value.gatsuki = '';\r\n                    this.value[groupType] = groupVal;\r\n                break;\r\n\r\n                case /calendar_year/.test(groupType):\r\n                    this.value.seirekiYear = groupVal;\r\n                    this.value.warekiName = _e.gengou.getName(groupVal + \"01\");\r\n                    this.value.warekiYear = _e.gengou.getWareki(groupVal + \"01\");\r\n                    this.value.nen = '年';\r\n                    this.value.gatsuki = '';\r\n                    this.value[groupType] = groupVal;\r\n                break;\r\n\r\n                default:\r\n                    this.value[groupType] = groupVal;\r\n                break;\r\n            }\r\n\r\n            this.seiwa = _e.isSet(area) ? area.conf.data.seiwa : 'SEIREKI';\r\n            this.formatString = '%seirekiYear%';\r\n            if(_e.getEnvLanguage() === 'jp'){\r\n                if(this.seiwa == 'SEIREKI'){\r\n                    this.formatString = '%seirekiYear%%nen%%gatsuki%';\r\n                }\r\n                if(this.seiwa == 'WAREKI'){\r\n                    this.formatString = '%warekiName%%warekiYear%%nen%%gatsuki%';\r\n                }\r\n                if(this.seiwa == 'HEIKI_S_W'){\r\n                    this.formatString = '%seirekiYear%%nen%%gatsuki%(%warekiName%%warekiYear%%nen%%gatsuki%)';\r\n                }\r\n                if(this.seiwa == 'HEIKI_W_S'){\r\n                    this.formatString = '%warekiName%%warekiYear%%nen%%gatsuki%(%seirekiYear%%nen%%gatsuki%)';\r\n                }\r\n            }\r\n        };\r\n\r\n    _e.formatGroupText = new FormatGroupText();\r\n    \r\n    \r\n    // JSONのフィルタ（コントローラ用）\r\n    function MakeFilteredItems(){}\r\n    \r\n        MakeFilteredItems.prototype.fiscal_ym = function(expectValue, groupArr, groupType, items, area){\r\n            return _e.makeFilteredItems.yearDefault.apply(this, [expectValue, groupArr, groupType, items, area]);\r\n        };\r\n\r\n        MakeFilteredItems.prototype.nendo = function(expectValue, groupArr, groupType, items, area){\r\n            return _e.makeFilteredItems.yearDefault.apply(this, [expectValue, groupArr, groupType, items, area]);\r\n        };\r\n\r\n        MakeFilteredItems.prototype.calendar_year = function(expectValue, groupArr, 