')\\n    let changeContents = solutionBox.querySelectorAll('.js-solution-contents')\\n    let changeTrigger = solutionBox.querySelectorAll('.js-solution-trigger')\\n    changeContents[0].classList.add('is-active')\\n    for (let i = 0; i < changeContents.length; i++) {\\n      changeTrigger[i].addEventListener('mouseover', function () {\\n        solutionBox.querySelector('.is-active').classList.remove('is-active')\\n        changeContents[i].classList.add('is-active')\\n      })\\n    }\\n  }\\n}\\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (hoverChange);\\n\\n\\n//# sourceURL=webpack://digitalift/./src/js/top/hoverChange.js?\");\n\n/***/ }),\n\n/***/ \"./src/js/top/solutionAccordion.js\":\n/*!*****************************************!*\\\n  !*** ./src/js/top/solutionAccordion.js ***!\n  \\*****************************************/\n/***/ ((__unused_webpack_module, __webpack_exports__, __webpack_require__) => {\n\neval(\"__webpack_require__.r(__webpack_exports__);\\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\\n/* harmony export */   \\\"default\\\": () => (__WEBPACK_DEFAULT_EXPORT__)\\n/* harmony export */ });\\nfunction solutionAccordion() {\\n  let isOpenArray = []\\n  const mediaQueryList = window.matchMedia('(min-width: 835px)'),\\n    tabBoxs = document.querySelectorAll('.js-menu')\\n  for (let i = 0; i < tabBoxs.length; i++) {\\n    const tabContent = tabBoxs[i].querySelector('.js-menu-item'),\\n      tab = tabBoxs[i].querySelector('.js-menu-trigger'),\\n      text = tabBoxs[i].querySelector('.js-menu-item-text'),\\n      link = tabBoxs[i].querySelector('.js-menu-item-link')\\n    const matchMediaEventListener = () => {\\n      isOpenArray[i] = false\\n      tab.classList.remove('is-open')\\n      tabContent.classList.remove('is-open')\\n      if (mediaQueryList.matches) {\\n        tabContent.style.maxHeight = null\\n      } else {\\n        tabContent.style.maxHeight = '0px'\\n      }\\n    }\\n    mediaQueryList.