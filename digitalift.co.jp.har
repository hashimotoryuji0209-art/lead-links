          "content": {
            "size": 7732,
            "mimeType": "application/javascript",
            "compression": 4802,
            "text": "if(!EIR){\r\n    var EIR = {};\r\n}\r\n\r\n(function(_e, $){\r\n\r\nvar utility = {\r\n    isAfterDate: function(after, before){\r\n        if(new Date(after).getTime() >= new Date(before).getTime()){\r\n            return true\r\n        }\r\n        return false;\r\n    },\r\n    // 第一引数のarrにtarget要素が無ければarrに要素を追加する\r\n    uniquePush: function(arr, target){\r\n        if(arr.indexOf(target) > -1){\r\n            return false;\r\n        }\r\n        arr.push(target);\r\n        return true;\r\n    },\r\n    isEmptyArr: function(arr){\r\n        if(arr.length === 0){\r\n            return true;\r\n        }\r\n        return false;\r\n    },\r\n    hasKeyWord: function(text, keywords, condition){\r\n        switch(condition){\r\n            case 'OR':\r\n            for(var ki = 0, klen = keyWords.length; ki < klen; ki++){\r\n                if(text.match(keyWords[ki])){\r\n                    return true;\r\n                }\r\n            }\r\n            return false;\r\n\r\n            case 'AND':\r\n            default:\r\n            for(var ki = 0, klen = keyWords.length; ki < klen; ki++){\r\n                if(!text.match(keyWords[ki])){\r\n                    return false;\r\n                }\r\n            }\r\n            return true;\r\n        }\r\n    },\r\n    // 配列中の特定のkeyの値が引数のvalueと一致するものを返す\r\n    serchObjectInnerArr: function(arr, key, value){\r\n        var finded = [];\r\n        for(var ai = 0, alen = arr.length; ai < alen; ai++){\r\n            if(_e.typeOf(arr[ai]) === 'object'){\r\n                if(arr[ai][key] === value){\r\n                    finded[finded.length] = arr[ai];\r\n                }\r\n            }\r\n        }\r\n        return finded;\r\n    },\r\n    findElm: function($elm, selecter){\r\n        var result = $($elm).filter(selecter);\r\n        if(!result.get(0)){\r\n            result = $($elm).find(selecter);\r\n        }\r\n        if(!result.get(0)){\r\n            return false;\r\n        }\r\n        return result;\r\n    },\r\n    typeOf: function(obj) {\r\n      return Object.prototype.toString.call(obj).slice(8, -1).toLowerCase();\r\n    },\r\n    isSet: function(arg){\r\n        switch(_e.typeOf(arg)){\r\n            case 'object':\r\n                return Object.keys(arg).length > 0 ? true : false;\r\n            case 'array':\r\n                return arg.length > 0 ? true : false;\r\n            case 'string':\r\n                return arg.length > 0 ? true : false;\r\n            case 'null':\r\n                return false;\r\n            case 'undefined':\r\n                return false;\r\n            case 'function': \r\n                return true;\r\n                \r\n        }\r\n        return true;\r\n    },\r\n    isEmpty: function(arg){\r\n        return !_e.isSet(arg);\r\n    },\r\n    parseUrlQuery: function(search){\r\n        var queryMap = {};\r\n        search = search || window.location.search;\r\n        if(search === ''){\r\n            return queryMap;\r\n        }\r\n        var queries\t= search.substr(1).split('&');\r\n        var split;\r\n\r\n        for(var i in queries){\r\n            split = queries[i].split('=');\r\n            queryMap[split[0]] = split[1];\r\n        }\r\n        return queryMap;\r\n    },\r\n    isHttpsLocation: function(){\r\n        return location.protocol === 'https:';\r\n    },\r\n    toSslPath: function(path){\r\n        return path.replace(/http\\:\\/\\/v4/, 'https://ssl4');\r\n    },\r\n    hereDoc: function(func){\r\n\t   return func.toString().match(/\\/\\*((\\s|\\S)*)\\*\\//)[1].trim();\r\n    },\r\n    createReplacer: createReplacer\r\n}\r\n$.extend(_e, utility);\r\n\r\n\r\nfunction createReplacer(replaceMap){\r\n    var keys = Object.keys(replaceMap),\r\n        regSource = '(?:' + keys.join('|') + ')',\r\n        testReg = RegExp(regSource),\r\n        replaceReg = RegExp(regSource, 'g'),\r\n        callback = function(m){\r\n            return replaceMap[m];\r\n        };\r\n\r\n    return function(text){\r\n        return testReg.test(text) ? text.replace(replaceReg, callback) : text;\r\n    }\r\n}\r\n\r\n// 【JSONの不具合対策】JSON英語の省略月を作成しないのでスクリプト側で作成する\r\n_e.formatEngMonth = createReplacer({\r\n\tJanuary: 'Jan',\r\n\tFebruary: 'Feb',\r\n\tMarch: 'Mar',\r\n\tApril: 'Apr',\r\n\tMay: 'May',\r\n\tJune: 'Jun',\r\n\tJuly: 'Jul',\r\n\tAugust: 'Aug',\r\n\tSeptember: 'Sep',\r\n\tOctober: 'Oct',\r\n\tNovember: 'Nov',\r\n\tDecember: 'Dec'\r\n});\r\n\r\n// 文字列のアンエスケープ\r\nfunction createUnescaper(){\r\n\tvar unEscapeMap = {\r\n\t\t'&quot;': '\"',\r\n\t\t'&apos;': '\\'',\r\n\t\t'&lt;'  : '<',\r\n\t\t'&gt;'  : '>',\r\n\t\t'&#92;' : '\\\\'\r\n\t};\r\n\treturn createReplacer(unEscapeMap);\r\n}\r\n_e.decodeText = createUnescaper();\r\n\r\n\r\n\r\n\r\n}(EIR, eirjQuery));\r\n\r\n\r\n// 以前の仕様に合わせてグローバル変数として元号オブジェクトを定義する\r\n// 今後gengouは修正を行わない。gengouYmのみ修正を行う。\r\nvar gengou = [{\t\t\t\r\n\t\"name\":\t\"新元\",\r\n\t\"start\":\"9998\",\r\n\t\"end\":\t\"9999\"\t\r\n},\t\t\t\r\n{\t\t\t\r\n\t\"name\":\t\"平成\",\r\n\t\"start\":\"1989\",\r\n\t\"end\":\t\"9997\"\t\r\n},\t\t\t\r\n{\t\t\t\r\n\t\"name\":\t\"昭和\",\r\n\t\"start\":\"1926\",\r\n\t\"end\":\t\"1988\"\t\r\n}];\r\nvar gengouList = gengou;\r\n\r\nvar gengouYm = [{\t\t\t\r\n\t\"name\":\t\"令和\",\r\n\t\"start\":\"201905\",\r\n\t\"end\":\t\"999999\"\t\r\n},\t\t\t\r\n{\t\t\t\r\n\t\"name\":\t\"平成\",\r\n\t\"start\":\"198901\",\r\n\t\"end\":\t\"201904\"\t\r\n},\t\t\t\r\n{\t\t\t\r\n\t\"name\":\t\"昭和\",\r\n\t\"start\":\"192612\",\r\n\t\"end\":\t\"198812\"\t\r\n}];\r\nvar gengouListYm = gengouYm;\r\n\r\n\r\n/**\r\n* 元号を扱うクラス\r\n*\r\n* @class Gengou\r\n* @constructor\r\n*/\r\nfunction Gengou(){}\r\neirjQuery.extend(Gengou.prototype, {\r\n    list: gengouList,\r\n\r\n    getGroup: function(seirekiY){\r\n        for(var l in this.list){\r\n            if(Number(seirekiY) >= Number(this.list[l].start)\r\n            && Number(seirekiY) <= Number(this.list[l].end)){\r\n                return this.list[l];\r\n            }\r\n        }\r\n    },\r\n\r\n    listYm: gengouListYm,\r\n\r\n    getGroupYm: function(seirekiYm){\r\n        for(var l in this.listYm){\r\n            if(Number(seirekiYm) >= Number(this.listYm[l].start)\r\n            && Number(seirekiYm) <= Number(this.listYm[l].end)){\r\n                return this.listYm[l];\r\n            }\r\n        }\r\n    },\r\n\r\n    getName: function(seirekiY){\r\n    \tif(seirekiY.length < 5) {\r\n        \treturn this.getGroup(Number(seirekiY)).name;\r\n    \t} else {\r\n    \t\treturn this.getGroupYm(Number(seirekiY)).name;\r\n    \t}\r\n    },\r\n\r\n    getWareki: function(seirekiY){\r\n    \tif(seirekiY.length < 5) {\r\n\t\t\tvar result = Number(seirekiY) - Number(this.getGroup(seirekiY).start) + 1;\r\n\t\t\tif(result === 1){\r\n\t\t\t\tresult = '元';\r\n\t\t\t}\r\n\t\t\treturn result;\r\n    \t} else {\r\n    \t\tvar result = Number(seirekiY.substr(0,4)) - Number(this.getGroupYm(seirekiY).start.substr(0,4)) + 1;\r\n\t\t\tif(result === 1){\r\n\t\t\t\tresult = '元';\r\n\t\t\t}\r\n\t\t\treturn result;\r\n    \t}\r\n    },\r\n\r\n\t// 和暦が含まれるテキストから西暦を作成する\r\n    wText2Seireki: function(text){\r\n    \tvar gengouName;\r\n    \tvar names = this.names;\r\n    \tfor(var n = 0, len = names.length; n < len; n++){\r\n    \t\tif(text.indexOf(names[n]) > -1){\r\n    \t\t\tgengouName = names[n];\r\n    \t\t}\r\n    \t}\r\n\t\tvar reg = new RegExp( gengouName + '(\\\\d+)\\\\s*年');\r\n\t\tvar warekiYY;\r\n\t\tif(text.match(reg)){\r\n    \t\twarekiYY = text.match(reg)[1];\r\n    \t}else if (text.indexOf('元年') > -1){\r\n\t\t\twarekiYY = 1;\r\n    \t}else{\r\n    \t\treturn false;\r\n    \t}\r\n\t\tvar list = this.listYm;\r\n\t\tvar start;\r\n    \tfor(var l = 0, len = list.length; l < len; l++){\r\n\t\t\tif(gengouName === list[l].name){\r\n\t\t\t\tstart = list[l].start.substr(0,4);\r\n\t\t\t}\r\n    \t}\r\n\r\n\t\tvar yyyy = Number(warekiYY) + Number(start) - 1;\r\n\t\treturn yyyy;\r\n    },\r\n\r\n    getFormatYear: function(seirekiY, month){},\r\n\r\n\t// 全ての元号名の一覧を保持する\r\n    names: (function(){\r\n    \tvar result = [];\r\n\t\tfor(var g = 0, len = gengouListYm.length; g < len; g++){\r\n\t\t\tresult[result.length] = gengouListYm[g].name;\r\n\t\t}\r\n\t\treturn result;\r\n    }())\r\n});"
          },
